{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "Storage": {
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "SecurityAssets": {
    "RootPath": "security-assets"
  },
  "MailboxDefaults": {
    "Folders": [ "INBOX", "Sent", "Drafts", "Trash", "Junk", "Archives" ]
  },
  "MailRules": {
    "SentCopyGraceSeconds": 60,
    "SentCopyDeduplicationMinutes": 15
  },
  "ConfigurationCache": {
    "Enabled": true,
    "SizeLimitBytes": 4194304,
    "MaximumEntryBytes": 1048576,
    "VersionPollSeconds": 3,
    "AbsoluteRefreshSeconds": 60,
    "MaximumConcurrentLoads": 2,
    "RuleFallbackBatchSize": 64,
    "StatusHeartbeatSeconds": 30,
    "ProcessStaleSeconds": 90,
    "ProcessRetentionHours": 24
  },
  "Forwarding": {
    "SrsSecret": "replace-with-an-independent-32-byte-secret",
    "MaxHops": 5,
    "MaxAgeDays": 21,
    "MaxTargetsPerRule": 20
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Certificates": {
    "DefaultMailHostName": "mail.localhost",
    "AllowSingleCertificateFallback": true,
    "Admin": {
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "PrivateKeyPassword": ""
    }
  },
  "AdminServer": {
    "BindAddress": "127.0.0.1",
    "Http": {
      "Enabled": true,
      "Port": 8080
    },
    "Https": {
      "Enabled": false,
      "Port": 8443,
      "RedirectHttp": true
    }
  },
  "Jwt": {
    "Issuer": "mailserver",
    "Audience": "mailserver-admin",
    "SigningKey": "replace-with-at-least-32-random-bytes",
    "Minutes": 15
  },
  "Smtp": {
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 300,
    "MaximumConnections": 200,
    "MaximumRecipients": 100,
    "MaximumMessageBytes": 52428800,
    "Endpoints": [
      { "Address": "0.0.0.0", "Port": 25, "Security": "StartTls", "RequireAuthentication": false },
      { "Address": "0.0.0.0", "Port": 465, "Security": "ImplicitTls", "RequireAuthentication": true, "AuthenticationMechanisms": [ "PLAIN", "LOGIN", "XOAUTH2", "OAUTHBEARER" ] },
      { "Address": "0.0.0.0", "Port": 587, "Security": "StartTls", "RequireAuthentication": true, "AuthenticationMechanisms": [ "PLAIN", "LOGIN", "XOAUTH2", "OAUTHBEARER" ] }
    ]
  },
  "SmtpAbuse": {
    "AuthenticationWindowMinutes": 15,
    "MaximumAuthenticationFailures": 5,
    "AuthenticationBlockMinutes": 30
  },
  "TransportSecurity": {
    "TrustedDnssecResolvers": "127.0.0.1,::1",
    "PolicyFetchTimeoutSeconds": 60,
    "PolicyRefreshHours": 24,
    "ReportOrganizationName": "Example Mail",
    "ReportContactInfo": "postmaster@example.com"
  },
  "Imap": {
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 1800,
    "MaximumConnections": 200,
    "MaximumAppendBytes": 52428800,
    "IdlePollSeconds": 15,
    "AuthenticationMechanisms": [ "LOGIN", "PLAIN", "XOAUTH2", "OAUTHBEARER" ],
    "Endpoints": [
      { "Address": "0.0.0.0", "Port": 143, "Security": "StartTls" },
      { "Address": "0.0.0.0", "Port": 993, "Security": "ImplicitTls" }
    ]
  },
  "Delivery": {
    "BatchSize": 20,
    "LeaseSeconds": 120,
    "MaximumAttempts": 12,
    "PollIntervalSeconds": 5
  },
  "Worker": {
    "HostName": "mail.localhost"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "MailServerLogging": {
    "Console": { "Enabled": true, "Color": true },
    "File": { "Enabled": true, "Directory": "logs" },
    "TimestampFormat": "yyyy/MM/dd HH:mm:ss"
  }
}
