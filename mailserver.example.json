{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "Storage": {
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Certificates": {
    "Mail": {
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "PrivateKeyPassword": ""
    },
    "Admin": {
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "PrivateKeyPassword": ""
    }
  },
  "AdminServer": {
    "BindAddress": "127.0.0.1",
    "Http": {
      "Enabled": true,
      "Port": 8080
    },
    "Https": {
      "Enabled": false,
      "Port": 8443,
      "RedirectHttp": true
    }
  },
  "Jwt": {
    "Issuer": "mailserver",
    "Audience": "mailserver-admin",
    "SigningKey": "replace-with-at-least-32-random-bytes",
    "Minutes": 15
  },
  "Smtp": {
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 300,
    "MaximumConnections": 200,
    "MaximumRecipients": 100,
    "MaximumMessageBytes": 52428800,
    "Endpoints": [
      { "Address": "0.0.0.0", "Port": 25, "ImplicitTls": false, "RequireAuthentication": false },
      { "Address": "0.0.0.0", "Port": 465, "ImplicitTls": true, "RequireAuthentication": true },
      { "Address": "0.0.0.0", "Port": 587, "ImplicitTls": false, "RequireAuthentication": true }
    ]
  },
  "Imap": {
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 1800,
    "MaximumConnections": 200,
    "MaximumAppendBytes": 52428800,
    "Endpoints": [
      { "Address": "0.0.0.0", "Port": 143, "ImplicitTls": false },
      { "Address": "0.0.0.0", "Port": 993, "ImplicitTls": true }
    ]
  },
  "Relay": {
    "Host": "localhost",
    "Port": 25,
    "UseStartTls": true,
    "UserName": "",
    "Password": ""
  },
  "Delivery": {
    "BatchSize": 20,
    "LeaseSeconds": 120,
    "MaximumAttempts": 12,
    "PollIntervalSeconds": 5
  },
  "Worker": {
    "HostName": "mail.localhost"
  }
}
