{
  "Database": {
    "Provider": "Sqlite",
    "ContextPoolSize": 32
  },
  "BackgroundServices": {
    "ProcessWakeEnabled": true
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "Storage": {
    "Provider": "File",
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "SecurityAssets": {
    "RootPath": "security-assets"
  },
  "MailboxDefaults": {
    "Folders": [
      "INBOX",
      "Sent",
      "Drafts",
      "Trash",
      "Junk",
      "Archives"
    ]
  },
  "MailRules": {
    "SentCopyGraceSeconds": 60,
    "SentCopyDeduplicationMinutes": 15
  },
  "ConfigurationCache": {
    "Enabled": true,
    "SizeLimitBytes": 4194304,
    "MaximumEntryBytes": 1048576,
    "VersionPollSeconds": 3,
    "AbsoluteRefreshSeconds": 60,
    "MaximumConcurrentLoads": 2,
    "RuleFallbackBatchSize": 64,
    "ProcessStaleSeconds": 90
  },
  "Forwarding": {
    "SrsSecret": "replace-with-an-independent-32-byte-secret",
    "MaxHops": 5,
    "MaxAgeDays": 21,
    "MaxTargetsPerRule": 20
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Certificates": {
    "DefaultMailHostName": "mail.localhost",
    "AllowSingleCertificateFallback": true,
    "Admin": {
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "PrivateKeyPassword": ""
    }
  },
  "AdminServer": {
    "BindAddress": "127.0.0.1",
    "Http": {
      "Enabled": true,
      "Port": 8080
    },
    "Https": {
      "Enabled": false,
      "Port": 8443,
      "RedirectHttp": true
    }
  },
  "Jwt": {
    "Issuer": "mailserver",
    "Audience": "mailserver-admin",
    "SigningKey": "replace-with-at-least-32-random-bytes",
    "Minutes": 15
  },
  "Smtp": {
    "ActiveMessageWaitMilliseconds": 2000,
    "MaximumWaitingMessages": 128,
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 300,
    "MaximumRecipients": 100,
    "MaximumMessageBytes": 52428800,
    "Endpoints": [
      {
        "Address": "0.0.0.0",
        "Port": 25,
        "Security": "StartTls",
        "RequireAuthentication": false
      },
      {
        "Address": "0.0.0.0",
        "Port": 465,
        "Security": "ImplicitTls",
        "RequireAuthentication": true,
        "AuthenticationMechanisms": [
          "PLAIN",
          "LOGIN",
          "XOAUTH2",
          "OAUTHBEARER"
        ]
      },
      {
        "Address": "0.0.0.0",
        "Port": 587,
        "Security": "StartTls",
        "RequireAuthentication": true,
        "AuthenticationMechanisms": [
          "PLAIN",
          "LOGIN",
          "XOAUTH2",
          "OAUTHBEARER"
        ]
      }
    ]
  },
  "SmtpAbuse": {
    "AuthenticationWindowMinutes": 15,
    "MaximumAuthenticationFailures": 5,
    "AuthenticationBlockMinutes": 30
  },
  "TransportSecurity": {
    "TrustedDnssecResolvers": "127.0.0.1,::1",
    "PolicyFetchTimeoutSeconds": 60,
    "PolicyRefreshHours": 24,
    "ReportOrganizationName": "Example Mail",
    "ReportContactInfo": "postmaster@example.com"
  },
  "Imap": {
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 1800,
    "MaximumAppendBytes": 52428800,
    "IdlePollSeconds": 15,
    "AuthenticationMechanisms": [
      "LOGIN",
      "PLAIN",
      "XOAUTH2",
      "OAUTHBEARER"
    ],
    "Endpoints": [
      {
        "Address": "0.0.0.0",
        "Port": 143,
        "Security": "StartTls"
      },
      {
        "Address": "0.0.0.0",
        "Port": 993,
        "Security": "ImplicitTls"
      }
    ]
  },
  "Delivery": {
    "BatchSize": 20,
    "LeaseSeconds": 120,
    "MaximumAttempts": 12,
    "PollIntervalSeconds": 5
  },
  "Worker": {
    "HostName": "mail.localhost"
  },
  "MessageSearch": {
    "UseCompleteHeaders": true,
    "UsePersistentSearchStreams": false,
    "CacheDecodedSearchBodies": true,
    "UseAsciiSearchNormalization": true,
    "Enabled": true,
    "BackfillBatchSize": 16,
    "BackfillDelaySeconds": 1
  },
  "SmtpConnectionReuse": {
    "Enabled": false,
    "MaximumIdleConnections": 64,
    "MaximumIdleConnectionsPerKey": 8,
    "IdleSeconds": 30,
    "MaximumLifetimeSeconds": 300,
    "MaximumMessages": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "MailServerLogging": {
    "Console": {
      "Enabled": true,
      "Color": true
    },
    "File": {
      "Enabled": true,
      "Directory": "logs"
    },
    "TimestampFormat": "yyyy/MM/dd HH:mm:ss"
  },
  "AdaptiveResources": {
    "Enabled": false,
    "AutomaticEnabled": false,
    "PauseBackfill": true,
    "InitialInbound": 16,
    "InitialOutbound": 32,
    "InitialHeavy": 4,
    "MaximumInbound": 32,
    "MaximumOutbound": 64,
    "MaximumHeavy": 12,
    "DatabaseBaselineWindowSeconds": 10
  }
}
