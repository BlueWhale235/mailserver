POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_PROVIDER=PostgreSql
MAIL_DATABASE_CONNECTION=Host=postgres;Port=5432;Database=mailserver;Username=mailserver;Password=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
MAIL_HOSTNAME=mail.example.com
MAIL_KEY_PASSWORD=
ADMIN_KEY_PASSWORD=
ADMIN_HTTP_ENABLED=true
ADMIN_HTTP_PORT=8080
ADMIN_HTTPS_ENABLED=false
ADMIN_HTTPS_PORT=8443
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993

# Default outbound relay. Set each domain to DirectMx through the API to bypass it.
RELAY_HOST=smtp.example.com
RELAY_PORT=587
RELAY_STARTTLS=true
RELAY_USERNAME=
RELAY_PASSWORD=
