MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DATABASE_PROVIDER=MySql
MAIL_DATABASE_CONNECTION=Server=mysql;Port=3306;Database=mailserver;User=mailserver;Password=replace-with-a-long-random-password
CONFIG_CACHE_PROCESS_BYTES=1048576
CONFIG_CACHE_ENTRY_BYTES=524288
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
MAIL_HOSTNAME=mail.example.com
ADMIN_KEY_PASSWORD=
ADMIN_HTTP_ENABLED=true
ADMIN_HTTP_PORT=8080
ADMIN_HTTPS_ENABLED=false
ADMIN_HTTPS_PORT=8443
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993

# MailServer 2.0 always delivers through Direct MX. Ensure outbound TCP/25,
# PTR, SPF, DKIM and DMARC are correctly configured for the sending IP.
