{
  "id": "mailserver-testplugin",
  "system": true,
  "displayName": "Test Plugin",
  "description": "A simple test plugin for demonstration purposes.",
  "version": "1.0.0",
  "contractVersion": "2.0",
  "entryAssembly": "MailServer.TestPlugin.dll",
  "order": 30,
  "hosts": [ "smtp" ],
  "timeoutMilliseconds": 5000,
  "failureMode": "continue",
  "defaultEnabled": true,
  "settings": [
    {
      "key": "minimumRetryMinutes",
      "type": "Integer",
      "label": "Minimum retry wait (minutes)",
      "description": "First-time combinations are deferred until this delay has elapsed.",
      "defaultValue": 5,
      "minimum": 1,
      "maximum": 1440
    },
    {
      "key": "recordExpiryDays",
      "type": "Integer",
      "label": "Record expiry (days)",
      "description": "Greylist records older than this are removed and must pass greylisting again.",
      "defaultValue": 30,
      "minimum": 1,
      "maximum": 365
    },
    {
      "key": "includeRemoteIp",
      "type": "Boolean",
      "label": "Match remote IP",
      "defaultValue": true
    },
    {
      "key": "includeSender",
      "type": "Boolean",
      "label": "Match envelope sender",
      "defaultValue": true
    },
    {
      "key": "includeRecipients",
      "type": "Boolean",
      "label": "Match recipient set",
      "defaultValue": true
    }
  ]
}
