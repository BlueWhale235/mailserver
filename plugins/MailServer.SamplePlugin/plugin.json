{
  "id": "sample-large-message-policy",
  "system": false,
  "displayName": "示例大邮件策略",
  "description": "演示消息接收策略以及 XOAUTH2/OAUTHBEARER 语义认证扩展点。",
  "defaultEnabled": false,
  "version": "1.0.0",
  "contractVersion": "1.0",
  "entryAssembly": "MailServer.SamplePlugin.dll",
  "order": 100,
  "hosts": ["smtp", "imap"],
  "timeoutMilliseconds": 1000,
  "failureMode": "reject",
  "settings": [
    {
      "key": "exampleIdentity",
      "type": "Text",
      "label": "示例本地邮箱地址",
      "description": "Token 验证成功后映射到的既有邮箱账号。",
      "defaultValue": ""
    },
    {
      "key": "exampleBearerToken",
      "type": "Password",
      "label": "示例 Bearer Token",
      "description": "仅用于开发和测试，不应用于生产环境。"
    }
  ]
}
