{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "Storage": {
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "SecurityAssets": {
    "RootPath": "security-assets"
  },
  "MailboxDefaults": {
    "Folders": [ "INBOX", "Sent", "Drafts", "Trash", "Junk", "Archives" ]
  },
  "MailRules": {
    "SentCopyGraceSeconds": 60,
    "SentCopyDeduplicationMinutes": 15
  },
  "ConfigurationCache": {
    "Enabled": true,
    "SizeLimitBytes": 4194304,
    "MaximumEntryBytes": 1048576,
    "VersionPollSeconds": 3,
    "AbsoluteRefreshSeconds": 60,
    "MaximumConcurrentLoads": 2,
    "RuleFallbackBatchSize": 64,
    "StatusHeartbeatSeconds": 30,
    "ProcessStaleSeconds": 90,
    "ProcessRetentionHours": 24
  },
  "Forwarding": {
    "SrsSecret": "",
    "MaxHops": 5,
    "MaxAgeDays": 21,
    "MaxTargetsPerRule": 20
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Certificates": {
    "DefaultMailHostName": "mail.localhost",
    "AllowSingleCertificateFallback": true
  },
  "Smtp": {
    "HostName": "mail.localhost",
    "CommandTimeoutSeconds": 300,
    "MaximumRecipients": 100,
    "MaximumMessageBytes": 52428800,
    "Endpoints": [
      { "Address": "0.0.0.0", "Port": 25, "Security": "StartTls", "RequireAuthentication": false },
      { "Address": "0.0.0.0", "Port": 465, "Security": "ImplicitTls", "RequireAuthentication": true },
      { "Address": "0.0.0.0", "Port": 587, "Security": "StartTls", "RequireAuthentication": true }
    ]
  },
  "SmtpAbuse": {
    "AuthenticationWindowMinutes": 15,
    "MaximumAuthenticationFailures": 5,
    "AuthenticationBlockMinutes": 30
  },
  "TransportSecurity": {
    "TrustedDnssecResolvers": "",
    "PolicyFetchTimeoutSeconds": 60,
    "PolicyRefreshHours": 24,
    "ReportOrganizationName": "MailServer",
    "ReportContactInfo": "postmaster@localhost"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "MailServerLogging": {
    "Console": { "Enabled": true, "Color": true },
    "File": { "Enabled": true, "Directory": "logs" },
    "TimestampFormat": "yyyy/MM/dd HH:mm:ss"
  }
}
