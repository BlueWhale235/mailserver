<label class="switch-field @CssClass">
    <input class="switch-input" type="checkbox" checked="@Value" disabled="@Disabled" @onchange="ChangedAsync" />
    <span class="switch-track" aria-hidden="true"></span>
    <span class="switch-copy">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <strong>@Label</strong>
        }
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <small>@Description</small>
        }
    </span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task ChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is bool value)
        {
            await ValueChanged.InvokeAsync(value);
        }
    }
}
