@if (Visible)
{
    <div class="panel-loading-overlay" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>@Text</span>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Text { get; set; } = "正在处理";
}
