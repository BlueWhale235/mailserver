@typeparam TItem

<div class="server-data-grid @CssClass">
    <div class="server-data-grid-toolbar">
        @if (ShowSearch)
        {
            <div class="input-icon">
                <i class="bi bi-search"></i>
                <input class="form-control" value="@_search" @oninput="SearchInputAsync" @onkeydown="SearchKeyDownAsync" placeholder="@SearchPlaceholder" />
            </div>
        }
        @ToolbarTemplate
    </div>

    <div class="table-responsive server-data-grid-table">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    @if (MultiSelect)
                    {
                        <th class="check-col">
                            <input type="checkbox" aria-label="选择当前页全部数据" checked="@AllVisibleSelected" @onchange="ToggleVisibleSelectionAsync" @onclick:stopPropagation />
                        </th>
                    }
                    @HeaderTemplate
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="@EffectiveColumnCount">
                            <div class="loading-row"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> 正在加载</div>
                        </td>
                    </tr>
                }
                else if (_items.Count == 0)
                {
                    <tr><td colspan="@EffectiveColumnCount" class="empty-cell">@EmptyText</td></tr>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        <tr class="@RowClass(item)" @onclick="@(() => RowClickedAsync(item))">
                            @if (MultiSelect)
                            {
                                <td class="check-col">
                                    <input type="checkbox" aria-label="选择此行" checked="@IsItemChecked(item)" @onchange="args => ToggleItemSelectionAsync(item, args)" @onclick:stopPropagation />
                                </td>
                            }
                            @RowTemplate(item)
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="server-data-grid-footer">
        <span>共 @_totalCount 条</span>
        @if (TotalPages > 1)
        {
            <div class="pager">
                <button type="button" class="pager-button" disabled="@(_page <= 1)" @onclick="@(() => GoToPageAsync(_page - 1))">上一页</button>
                <span>@_page / @TotalPages</span>
                <button type="button" class="pager-button" disabled="@(_page >= TotalPages)" @onclick="@(() => GoToPageAsync(_page + 1))">下一页</button>
                <SelectDropdown TValue="int" @bind-Value="_pageSize" @bind-Value:after="ReloadFromFirstPageAsync"
                                Options="PageSizeSelectOptions" AriaLabel="每页条数" CssClass="page-size" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Func<string, int, int, Task<PagedResult<TItem>>> LoadData { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment HeaderTemplate { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = null!;
    [Parameter] public RenderFragment? ToolbarTemplate { get; set; }
    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }
    [Parameter] public Func<TItem, Guid>? ItemKey { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public bool ToggleOnRowClick { get; set; }
    [Parameter] public IReadOnlySet<Guid> SelectedIds { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback<IReadOnlySet<Guid>> SelectedIdsChanged { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "搜索";
    [Parameter] public string EmptyText { get; set; } = "暂无数据";
    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 20, 50];
    [Parameter] public int InitialPageSize { get; set; } = 10;
    [Parameter] public int ColumnCount { get; set; } = 4;
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool SearchOnInput { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }

    private readonly List<TItem> _items = [];
    private int _page = 1;
    private int _pageSize;
    private int _totalCount;
    private bool _loading;
    private string _search = string.Empty;
    private CancellationTokenSource? _searchDelay;

    private IReadOnlyList<AdminSelectOption<int>> PageSizeSelectOptions =>
        PageSizeOptions.Select(option => new AdminSelectOption<int>(option, $"{option} 条/页")).ToArray();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)Math.Max(1, _pageSize)));
    private int EffectiveColumnCount => ColumnCount + (MultiSelect ? 1 : 0);
    private bool AllVisibleSelected => MultiSelect
                                      && ItemKey is not null
                                      && _items.Count > 0
                                      && _items.All(item => SelectedIds.Contains(ItemKey(item)));

    protected override async Task OnInitializedAsync()
    {
        _pageSize = PageSizeOptions.Contains(InitialPageSize) ? InitialPageSize : PageSizeOptions.FirstOrDefault(10);
        await LoadAsync();
    }

    private async Task SearchInputAsync(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        if (!SearchOnInput)
        {
            return;
        }

        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        var token = _searchDelay.Token;

        try
        {
            await Task.Delay(250, token);
            if (!token.IsCancellationRequested)
            {
                await ReloadFromFirstPageAsync();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (!SearchOnInput && args.Key == "Enter")
        {
            await ReloadFromFirstPageAsync();
        }
    }

    public async Task ReloadFromFirstPageAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    public async Task RefreshAsync(bool firstPage = false)
    {
        if (firstPage)
        {
            _page = 1;
        }

        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await LoadData(_search, _page, _pageSize);
            _items.Clear();
            _items.AddRange(result.Items);
            _totalCount = result.TotalCount;
            if (_page > TotalPages)
            {
                _page = TotalPages;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectAsync(TItem item)
    {
        SelectedItem = item;
        await SelectedItemChanged.InvokeAsync(item);
    }

    private bool IsSelected(TItem item) => EqualityComparer<TItem?>.Default.Equals(SelectedItem, item);

    private async Task RowClickedAsync(TItem item)
    {
        if (MultiSelect)
        {
            if (ToggleOnRowClick)
            {
                await ToggleItemKeyAsync(item, !IsItemChecked(item));
            }

            return;
        }

        await SelectAsync(item);
    }

    private string RowClass(TItem item)
    {
        var classes = new List<string>();
        if (!MultiSelect)
        {
            classes.Add("selectable-row");
        }
        else if (ToggleOnRowClick)
        {
            classes.Add("selectable-row");
        }

        if (IsSelected(item) || IsItemChecked(item))
        {
            classes.Add("selected");
        }

        return string.Join(" ", classes);
    }

    private bool IsItemChecked(TItem item) =>
        MultiSelect && ItemKey is not null && SelectedIds.Contains(ItemKey(item));

    private async Task ToggleItemSelectionAsync(TItem item, ChangeEventArgs args)
    {
        await ToggleItemKeyAsync(item, args.Value is true);
    }

    private async Task ToggleItemKeyAsync(TItem item, bool selected)
    {
        if (ItemKey is null)
        {
            return;
        }

        var ids = SelectedIds.ToHashSet();
        var id = ItemKey(item);
        if (selected)
        {
            ids.Add(id);
        }
        else
        {
            ids.Remove(id);
        }

        await SelectedIdsChanged.InvokeAsync(ids);
    }

    private async Task ToggleVisibleSelectionAsync(ChangeEventArgs args)
    {
        if (ItemKey is null)
        {
            return;
        }

        var selected = args.Value is true;
        var ids = SelectedIds.ToHashSet();
        foreach (var item in _items)
        {
            var id = ItemKey(item);
            if (selected)
            {
                ids.Add(id);
            }
            else
            {
                ids.Remove(id);
            }
        }

        await SelectedIdsChanged.InvokeAsync(ids);
    }
}
