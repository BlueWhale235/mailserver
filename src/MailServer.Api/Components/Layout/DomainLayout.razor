@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AdminApplicationService Administration

<AdminShell>
    <Navigation>
        @if (_domainId is { } domainId)
        {
            <DomainAdminNavigation DomainId="@domainId" DomainName="@_domainName" />
        }
    </Navigation>
    <ChildContent>@Body</ChildContent>
</AdminShell>

@code {
    private Guid? _domainId;
    private string _domainName = "域名管理";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadDomainContextAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        await LoadDomainContextAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDomainContextAsync()
    {
        var segments = new Uri(Navigation.Uri).AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var index = Array.FindIndex(segments, x => x.Equals("domains", StringComparison.OrdinalIgnoreCase));
        if (index < 0 || index + 1 >= segments.Length || !Guid.TryParse(segments[index + 1], out var domainId))
        {
            _domainId = null;
            _domainName = "域名管理";
            return;
        }

        if (_domainId == domainId && _domainName != "域名管理")
        {
            return;
        }

        _domainId = domainId;
        try
        {
            _domainName = (await Administration.GetDomainAsync(domainId, CancellationToken.None)).Domain.Name;
        }
        catch (KeyNotFoundException)
        {
            _domainName = "域名不存在";
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
