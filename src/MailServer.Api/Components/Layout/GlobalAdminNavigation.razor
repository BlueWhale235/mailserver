@inject AuthenticationStateProvider Authentication
@inject PermissionService Permissions

<nav class="admin-nav" aria-label="后台导航">
    @if (_loaded)
    {
        @if (Can(PermissionCodes.DashboardRead) || CanAnyDomain())
        {
            <div class="nav-section-label">工作台</div>
            @if (Can(PermissionCodes.DashboardRead))
            {
                <NavLink class="admin-nav-link" href="/admin" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2"></i><span>仪表盘</span>
                </NavLink>
            }
            @if (CanAnyDomain())
            {
                <NavLink class="admin-nav-link" href="/admin/domains">
                    <i class="bi bi-hdd-network"></i><span>域名管理</span>
                </NavLink>
            }
        }

        @if (CanApi || CanSecurity || CanAny(PermissionCodes.FirewallRead, PermissionCodes.FirewallManage))
        {
            <div class="nav-section-label">权限设置</div>
            @if (CanApi)
            {
                <NavLink class="admin-nav-link" href="/admin/api-keys">
                    <i class="bi bi-key"></i><span>API 管理</span>
                </NavLink>
            }
            @if (CanSecurity)
            {
                <NavLink class="admin-nav-link" href="/admin/security">
                    <i class="bi bi-shield-lock"></i><span>权限管理</span>
                </NavLink>
            }
            @if (CanAny(PermissionCodes.FirewallRead, PermissionCodes.FirewallManage))
            {
                <NavLink class="admin-nav-link" href="/admin/firewall">
                    <i class="bi bi-shield-exclamation"></i><span>防火墙</span>
                </NavLink>
            }
        }

        @if (Can(PermissionCodes.QueueRead)
            || Can(PermissionCodes.DnsRead)
            || Can(PermissionCodes.SettingsRead))
        {
            <div class="nav-section-label">系统设置</div>
            @if (Can(PermissionCodes.QueueRead))
            {
                <NavLink class="admin-nav-link" href="/admin/queue">
                    <i class="bi bi-send"></i><span>投递队列</span>
                </NavLink>
            }
            @if (Can(PermissionCodes.DnsRead))
            {
                <NavLink class="admin-nav-link" href="/admin/dns">
                    <i class="bi bi-globe2"></i><span>DNS 诊断</span>
                </NavLink>
            }
            @if (Can(PermissionCodes.SettingsRead))
            {
                <NavLink class="admin-nav-link" href="/admin/plugins">
                    <i class="bi bi-plugin"></i><span>插件配置</span>
                </NavLink>
                <NavLink class="admin-nav-link" href="/admin/notification-templates">
                    <i class="bi bi-envelope-paper"></i><span>通知模板</span>
                </NavLink>
                <NavLink class="admin-nav-link" href="/admin/settings">
                    <i class="bi bi-gear"></i><span>系统设置</span>
                </NavLink>
            }
        }

        @if (CanApi)
        {
            <div class="admin-nav-bottom">
                <a class="admin-nav-link" href="/swagger/index.html" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-braces"></i><span>API</span>
                </a>
            </div>
        }
    }
</nav>

@code {
    private bool _loaded;
    private PermissionSnapshot _permissions = new();

    private bool CanApi => Can(PermissionCodes.IamManage)
                           || CanAny(
                               PermissionCodes.ApiKeyRead,
                               PermissionCodes.ApiKeyManage);

    private bool CanSecurity => Can(PermissionCodes.IamManage)
                                || CanAny(
                                    PermissionCodes.AdminAccountRead,
                                    PermissionCodes.AdminAccountManage);

    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _permissions = await Permissions.GetSnapshotAsync(user, CancellationToken.None);
        _loaded = true;
    }

    private bool Can(string code) => _permissions.Has(code);
    private bool CanAny(params string[] codes) => _permissions.HasAny(codes);
    private bool CanAnyDomain() => _permissions.HasAnyDomainPermission(PermissionCodes.DomainRead)
                                  || _permissions.HasAllDomains(PermissionCodes.DomainManage);
}
