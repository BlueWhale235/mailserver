@inject AdminApplicationService Administration
@inject AuthenticationStateProvider Authentication
@inject AdminToastService Toasts
@inject PermissionService Permissions
@inject IJSRuntime JS

@if (!_loaded)
{
    <div class="loading-row"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> 正在加载</div>
}
else if (!CanRead)
{
    <AccessDeniedPanel />
}
else
{
<section class="panel">
    <div class="panel-header">
        <div>
            <h2>@(DomainId is null ? "队列任务" : "当前域名队列")</h2>
            <p>可勾选多个投递任务后批量重试或删除。</p>
        </div>
        @if (ShowHeaderRefresh)
        {
            <button class="btn btn-outline-primary admin-btn" type="button" @onclick="ReloadGridAsync">
                <i class="bi bi-arrow-clockwise"></i>
                刷新
            </button>
        }
    </div>

    @if (_selectedJobIds.Count > 0)
    {
        <div class="batch-action-bar table-batch-bar">
            <strong>已选择 @_selectedJobIds.Count 项</strong>
            @if (CanManage)
            {
                <button class="btn btn-outline-primary admin-btn" type="button" @onclick="RetrySelectedAsync">
                    <i class="bi bi-arrow-repeat"></i>
                    批量重试
                </button>
                <button class="btn btn-danger admin-btn" type="button" @onclick="DeleteSelectedAsync">
                    <i class="bi bi-trash"></i>
                    批量删除
                </button>
            }
            <button class="btn btn-outline-secondary admin-btn batch-clear" type="button" @onclick="ClearSelection">取消选择</button>
        </div>
    }

    <ServerDataGrid @ref="_grid" TItem="DeliveryJob" LoadData="LoadJobsAsync"
                    SearchPlaceholder="搜索发件人、收件人或错误信息" EmptyText="当前没有投递任务"
                    ColumnCount="7" InitialPageSize="10" MultiSelect="true"
                    ItemKey="job => job.Id" SelectedIds="_selectedJobIds" SelectedIdsChanged="JobSelectionChanged">
        <ToolbarTemplate>
            <SelectDropdown TValue="string" @bind-Value="_status" Options="StatusOptions"
                            AriaLabel="投递状态" CssClass="compact-select" />
            <button class="btn btn-primary admin-btn" type="button" @onclick="ReloadGridFirstPageAsync">
                <i class="bi bi-search"></i>
                搜索
            </button>
        </ToolbarTemplate>
        <HeaderTemplate>
            <th>收件人</th>
            <th>发件人</th>
            <th>状态</th>
            <th>尝试次数</th>
            <th>下次尝试</th>
            <th>最近错误</th>
            <th class="actions-cell">操作</th>
        </HeaderTemplate>
        <RowTemplate Context="job">
            <td>@job.Recipient</td>
            <td>@job.Sender</td>
            <td><span class="status-pill status-@job.Status.ToString().ToLowerInvariant()">@StatusText(job.Status)</span></td>
            <td>@job.Attempts</td>
            <td>@FormatTime(job.NextAttemptAt)</td>
            <td class="muted queue-error-cell">@job.LastError</td>
            <td>
                <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => OpenDetails(job)">
                    <i class="bi bi-card-text"></i>
                    详情
                </button>
            </td>
        </RowTemplate>
    </ServerDataGrid>
</section>

@if (_detailJob is not null)
{
    <div class="modal-backdrop" @onclick="CloseDetails">
        <div class="modal-panel queue-detail-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>投递详情</h2>
                    <p>@_detailJob.Recipient</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CloseDetails"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="tabs compact-tabs">
                <button type="button" class="@TabClass(DetailInfoTab)" @onclick="ShowInfoTab">基本信息</button>
                <button type="button" class="@TabClass(DetailRawTab)" @onclick="OpenRawTabAsync">邮件头</button>
            </div>
            @if (_detailTab == DetailInfoTab)
            {
                <div class="definition-grid">
                    <strong>任务 ID</strong><code>@_detailJob.Id</code>
                    <strong>发件人</strong><span>@_detailJob.Sender</span>
                    <strong>收件人</strong><span>@_detailJob.Recipient</span>
                    <strong>状态</strong><span><span class="status-pill status-@_detailJob.Status.ToString().ToLowerInvariant()">@StatusText(_detailJob.Status)</span></span>
                    <strong>投递方式</strong><span>@_detailJob.RouteMode</span>
                    <strong>尝试次数</strong><span>@_detailJob.Attempts</span>
                    <strong>下次尝试</strong><span>@FormatTime(_detailJob.NextAttemptAt)</span>
                    <strong>最近错误</strong><span>@(_detailJob.LastError ?? "无")</span>
                    <strong>创建时间</strong><span>@FormatTime(_detailJob.CreatedAt)</span>
                    <strong>更新时间</strong><span>@FormatTime(_detailJob.UpdatedAt)</span>
                </div>
            }
            else
            {
                <div class="raw-message-panel">
                    <div class="raw-message-toolbar">
                        <strong>@(_rawMessage?.FileName ?? "邮件头")</strong>
                        <div class="actions">
                            <button class="btn btn-outline-primary admin-btn compact-action" type="button" disabled="@(_rawMessage is null)" @onclick="CopyRawAsync">
                                <i class="bi bi-clipboard"></i>
                                复制邮件头
                            </button>
                            <button class="btn btn-outline-primary admin-btn compact-action" type="button" disabled="@(_detailJob is null)" @onclick="DownloadRawAsync">
                                <i class="bi bi-download"></i>
                                下载完整邮件
                            </button>
                        </div>
                    </div>
                    @if (_rawLoading)
                    {
                        <div class="loading-row"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> 正在读取邮件头</div>
                    }
                    else if (_rawMessage is not null)
                    {
                        <pre class="raw-message-content">@_rawMessage.Content</pre>
                    }
                </div>
            }
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseDetails">关闭</button>
                @if (CanManage)
                {
                    <button class="btn btn-primary admin-btn" type="button" @onclick="() => RetryAsync(_detailJob!.Id, true)">
                        <i class="bi bi-arrow-repeat"></i>
                        立即重试投递
                    </button>
                    <button class="btn btn-danger admin-btn" type="button" @onclick="() => DeleteAsync(_detailJob!.Id, true)">
                        <i class="bi bi-trash"></i>
                        删除
                    </button>
                }
            </div>
        </div>
    </div>
}
}

@code {
    [Parameter] public Guid? DomainId { get; set; }
    [Parameter] public bool ShowHeaderRefresh { get; set; } = true;

    private const string DetailInfoTab = "info";
    private const string DetailRawTab = "raw";

    private ServerDataGrid<DeliveryJob>? _grid;
    private HashSet<Guid> _selectedJobIds = [];
    private string _status = string.Empty;
    private DeliveryJob? _detailJob;
    private DeliveryRawMessageView? _rawMessage;
    private bool _rawLoading;
    private string _detailTab = DetailInfoTab;
    private bool _loaded;
    private PermissionSnapshot _permissions = new();

    private static readonly IReadOnlyList<AdminSelectOption<string>> StatusOptions =
    [
        new(string.Empty, "全部状态"),
        .. Enum.GetValues<DeliveryStatus>().Select(status => new AdminSelectOption<string>(status.ToString(), StatusText(status)))
    ];

    private bool CanRead => DomainId is { } domainId
        ? _permissions.Has(PermissionCodes.DomainRead, domainId)
        : _permissions.Has(PermissionCodes.QueueRead);

    private bool CanManage => DomainId is { } domainId
        ? _permissions.Has(PermissionCodes.DomainManage, domainId)
        : _permissions.Has(PermissionCodes.QueueManage);

    protected override async Task OnParametersSetAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _permissions = await Permissions.GetSnapshotAsync(user, CancellationToken.None);
        _loaded = true;
    }

    private Task<PagedResult<DeliveryJob>> LoadJobsAsync(string search, int page, int pageSize)
    {
        if (!CanRead)
        {
            return Task.FromResult(new PagedResult<DeliveryJob>([], page, pageSize, 0));
        }

        DeliveryStatus? status = Enum.TryParse<DeliveryStatus>(_status, out var value) ? value : null;
        return Administration.SearchDeliveryJobsAsync(search, status, page, pageSize, CancellationToken.None, DomainId);
    }

    public async Task RefreshAsync() => await ReloadGridAsync();

    private async Task ReloadGridAsync()
    {
        if (_grid is not null) await _grid.RefreshAsync();
    }

    private async Task ReloadGridFirstPageAsync()
    {
        if (_grid is not null) await _grid.ReloadFromFirstPageAsync();
    }

    private void JobSelectionChanged(IReadOnlySet<Guid> ids) => _selectedJobIds = ids.ToHashSet();
    private void ClearSelection() => _selectedJobIds.Clear();

    private void OpenDetails(DeliveryJob job)
    {
        _detailJob = job;
        _detailTab = DetailInfoTab;
        _rawMessage = null;
        _rawLoading = false;
    }

    private void CloseDetails() => _detailJob = null;
    private void ShowInfoTab() => _detailTab = DetailInfoTab;

    private async Task OpenRawTabAsync()
    {
        _detailTab = DetailRawTab;
        if (_rawMessage is not null || _rawLoading || _detailJob is null) return;

        _rawLoading = true;
        try
        {
            _rawMessage = await Administration.GetDeliveryMessageHeadersAsync(_detailJob.Id, CancellationToken.None, DomainId);
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _rawLoading = false;
        }
    }

    private async Task CopyRawAsync()
    {
        if (_rawMessage is null) return;
        try
        {
            var copied = await JS.InvokeAsync<bool>("mailserverClipboard.copyText", _rawMessage.Content);
            if (!copied)
            {
                throw new InvalidOperationException("浏览器拒绝访问系统剪贴板。");
            }

            Toasts.Success("邮件头已复制到本地剪贴板。");
        }
        catch (Exception exception)
        {
            Toasts.Error($"复制失败：{exception.Message}");
        }
    }

    private async Task DownloadRawAsync()
    {
        if (_detailJob is null) return;
        var routeDomainQuery = DomainId is { } domainId
            ? $"?routeDomainId={Uri.EscapeDataString(domainId.ToString())}"
            : string.Empty;
        await JS.InvokeVoidAsync(
            "mailserverDownloadUrl",
            $"/admin/delivery-queue/{_detailJob.Id}/download{routeDomainQuery}");
        Toasts.Success("完整邮件已开始下载。");
    }

    private async Task RetrySelectedAsync()
    {
        if (!CanManage)
        {
            Toasts.Error("当前账号没有重试投递的权限。");
            return;
        }

        try
        {
            foreach (var id in _selectedJobIds.ToArray())
            {
                await Administration.RetryDeliveryAsync(id, await ActorAsync(), CancellationToken.None, DomainId);
            }
            _selectedJobIds.Clear();
            Toasts.Success("所选投递任务已加入立即重试。");
            await ReloadGridAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (!CanManage)
        {
            Toasts.Error("当前账号没有删除投递任务的权限。");
            return;
        }

        try
        {
            foreach (var id in _selectedJobIds.ToArray())
            {
                await Administration.DeleteDeliveryAsync(id, await ActorAsync(), CancellationToken.None, DomainId);
            }
            _selectedJobIds.Clear();
            Toasts.Success("所选投递任务已删除。");
            await ReloadGridAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task RetryAsync(Guid id, bool closeModal)
    {
        if (!CanManage)
        {
            Toasts.Error("当前账号没有重试投递的权限。");
            return;
        }

        try
        {
            await Administration.RetryDeliveryAsync(id, await ActorAsync(), CancellationToken.None, DomainId);
            if (closeModal) CloseDetails();
            Toasts.Success("投递任务已加入立即重试。");
            await ReloadGridAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task DeleteAsync(Guid id, bool closeModal)
    {
        if (!CanManage)
        {
            Toasts.Error("当前账号没有删除投递任务的权限。");
            return;
        }

        try
        {
            await Administration.DeleteDeliveryAsync(id, await ActorAsync(), CancellationToken.None, DomainId);
            _selectedJobIds.Remove(id);
            if (closeModal) CloseDetails();
            Toasts.Success("投递任务已删除。");
            await ReloadGridAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task<string> ActorAsync() =>
        (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin-ui";

    private static string StatusText(DeliveryStatus status) => status switch
    {
        DeliveryStatus.Pending => "待处理",
        DeliveryStatus.Processing => "处理中",
        DeliveryStatus.Delivered => "已送达",
        DeliveryStatus.Deferred => "延迟重试",
        DeliveryStatus.Failed => "失败",
        _ => status.ToString()
    };

    private static string FormatTime(DateTimeOffset value) => value.LocalDateTime.ToString("yyyy-MM-dd HH:mm");
    private string TabClass(string tab) => _detailTab == tab ? "tab-button active" : "tab-button";
}
