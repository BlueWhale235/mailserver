<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <style>
        :root{font-family:Inter,Segoe UI,sans-serif;color:#172033;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}.shell{min-height:100vh;display:grid;grid-template-columns:230px 1fr}aside{background:#101827;color:#dbe4f3;padding:24px;display:flex;flex-direction:column;gap:28px}.brand{font-size:22px;font-weight:750;color:white;text-decoration:none}nav{display:grid;gap:7px}nav a,.link-button{color:#b9c7dc;text-decoration:none;padding:10px 12px;border-radius:9px;background:none;border:0;text-align:left;font:inherit;cursor:pointer}nav a.active,nav a:hover,.link-button:hover{color:white;background:#243249}main{padding:36px;overflow:auto}h1{margin-top:0}.warning,.error{color:#9a3412}.warning{background:#ffedd5;padding:12px;border-radius:10px}.success{color:#166534}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px}.cards section,.panel,.login-card,.secret{background:white;border:1px solid #e1e7f0;border-radius:14px;padding:20px;box-shadow:0 8px 24px #2538580d}.cards strong{display:block;font-size:28px}.cards span{color:#667085}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}input,select,button{font:inherit;padding:10px 12px;border:1px solid #cbd5e1;border-radius:8px}button{background:#2563eb;color:white;border-color:#2563eb;cursor:pointer}button.secondary{background:white;color:#1e40af}button.danger{background:#b42318;border-color:#b42318}button:disabled{opacity:.45;cursor:not-allowed}table{width:100%;border-collapse:collapse;background:white;border-radius:12px;overflow:hidden}th,td{text-align:left;padding:12px;border-bottom:1px solid #e5e7eb;vertical-align:top}th{background:#eef2f7}.login-card{max-width:420px;margin:10vh auto}.login-card form,.form-grid{display:grid;gap:14px}.login-card label,.form-grid label{display:grid;gap:6px}.checkbox{display:flex!important;grid-template-columns:auto 1fr;align-items:center}.secret{margin:14px 0;background:#ecfdf3}.secret code{display:block;overflow-wrap:anywhere;margin-top:8px}@@media(max-width:800px){.shell{grid-template-columns:1fr}aside{position:static}main{padding:20px}nav{grid-template-columns:repeat(2,1fr)}}
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
