<div class="token-input" @onfocusout="CommitAsync">
    @foreach (var token in _tokens)
    {
        <button class="token-chip" type="button" @onclick="@(() => RemoveAsync(token))" title="移除 @token">
            <span>@token</span>
            <i class="bi bi-x"></i>
        </button>
    }
    <input @bind="_draft" @bind:event="oninput" @bind:after="DraftUpdatedAsync" @onkeydown="KeyDownAsync"
           placeholder="@(_tokens.Count == 0 ? Placeholder : string.Empty)" aria-label="@AriaLabel" />
</div>

@code {
    [Parameter] public IReadOnlyList<string> Values { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "输入后按 Enter";
    [Parameter] public string AriaLabel { get; set; } = "规则值";

    private readonly List<string> _tokens = [];
    private string _draft = string.Empty;

    protected override void OnParametersSet()
    {
        if (_tokens.SequenceEqual(Values, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        _tokens.Clear();
        _tokens.AddRange(Values);
    }

    private async Task DraftUpdatedAsync()
    {
        if (_draft.IndexOfAny([',', '\n', '\r']) >= 0)
        {
            await CommitAsync();
        }
    }

    private async Task KeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or ",")
        {
            await CommitAsync();
        }
        else if (args.Key == "Backspace" && _draft.Length == 0 && _tokens.Count > 0)
        {
            _tokens.RemoveAt(_tokens.Count - 1);
            await ValuesChanged.InvokeAsync(_tokens.ToArray());
        }
    }

    private async Task CommitAsync()
    {
        var additions = _draft.Split([',', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var value in additions)
        {
            if (!_tokens.Contains(value, StringComparer.OrdinalIgnoreCase))
            {
                _tokens.Add(value);
            }
        }

        _draft = string.Empty;
        await ValuesChanged.InvokeAsync(_tokens.ToArray());
    }

    private async Task RemoveAsync(string token)
    {
        _tokens.RemoveAll(x => x.Equals(token, StringComparison.OrdinalIgnoreCase));
        await ValuesChanged.InvokeAsync(_tokens.ToArray());
    }
}
