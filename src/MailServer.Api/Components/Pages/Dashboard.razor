@page "/admin"
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject AuthenticationStateProvider Authentication
@inject PermissionService Permissions

<PageTitle>MailServer 概览</PageTitle>
<AdminPageHeader Title="概览" Description="查看邮件域、账号、队列和存储的当前状态。" />

@if (_accessDenied)
{
    <AccessDeniedPanel />
}
else if (_dashboard is null)
{
    <p>正在加载...</p>
}
else
{
    <div class="cards">
        <section><strong>@_dashboard.Domains</strong><span>域名</span></section>
        <section><strong>@_dashboard.Accounts</strong><span>账号</span></section>
        <section><strong>@_dashboard.Aliases</strong><span>别名</span></section>
        <section><strong>@_dashboard.PendingDeliveries</strong><span>待投递</span></section>
        <section><strong>@_dashboard.FailedDeliveries</strong><span>失败任务</span></section>
        <section><strong>@FormatBytes(_dashboard.StoredBytes)</strong><span>邮件存储</span></section>
    </div>
}

@code {
    private AdminDashboard? _dashboard;
    private bool _accessDenied;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        if (!await Permissions.HasPermissionAsync(user, PermissionCodes.DashboardView, null, CancellationToken.None))
        {
            _accessDenied = true;
            return;
        }

        _dashboard = await Administration.GetDashboardAsync(CancellationToken.None);
    }

    private static string FormatBytes(long value) =>
        value >= 1_073_741_824 ? $"{value / 1_073_741_824d:F1} GiB" :
        value >= 1_048_576 ? $"{value / 1_048_576d:F1} MiB" :
        value >= 1024 ? $"{value / 1024d:F1} KiB" : $"{value} B";
}
