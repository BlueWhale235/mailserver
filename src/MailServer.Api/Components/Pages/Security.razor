@page "/admin/security"
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject AuthenticationStateProvider Authentication
@inject AdminToastService Toasts
@inject PermissionService Permissions

<PageTitle>权限管理</PageTitle>

<AdminPageHeader Title="权限管理" Description="维护后台管理员账号、登录状态、密码和授权。" />

@if (!_loaded)
{
    <p>正在加载...</p>
}
else if (_accessDenied)
{
    <AccessDeniedPanel />
}
else if (Can(PermissionCodes.AdminAccountList))
{
<section class="panel">
    <div class="panel-header">
        <div>
            <h2>管理员账号</h2>
            <p>初始管理员固定拥有全局权限，名称、启用状态和授权不可修改，也不能被删除。</p>
        </div>
        <div class="actions">
            <button class="btn btn-outline-primary admin-btn" type="button" @onclick="ReloadGridAsync">
                <i class="bi bi-arrow-clockwise"></i>
                刷新
            </button>
            @if (CanCreateAdmin)
            {
                <button class="btn btn-primary admin-btn" type="button" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg"></i>
                    添加管理员
                </button>
            }
        </div>
    </div>

    <ServerDataGrid @ref="_grid" TItem="AdminUserView" LoadData="LoadAdminsAsync"
                    SearchPlaceholder="搜索管理员名称" EmptyText="没有符合条件的管理员"
                    ColumnCount="5" InitialPageSize="10">
        <ToolbarTemplate>
            <SelectDropdown TValue="AdminUserStatusFilter" @bind-Value="_status" Options="StatusOptions"
                            AriaLabel="管理员状态" CssClass="compact-select" />
            <button class="btn btn-primary admin-btn" type="button" @onclick="ReloadGridFirstPageAsync">
                <i class="bi bi-search"></i>
                搜索
            </button>
        </ToolbarTemplate>
        <HeaderTemplate>
            <th>名称</th>
            <th>状态</th>
            <th>创建时间</th>
            <th>说明</th>
            <th class="actions-cell">操作</th>
        </HeaderTemplate>
        <RowTemplate Context="admin">
            <td>
                <strong>@admin.UserName</strong>
                @if (admin.IsPrimary)
                {
                    <span class="row-hint">初始管理员</span>
                }
            </td>
            <td><span class="status-pill @(admin.IsEnabled ? "status-enabled" : "status-disabled")">@(admin.IsEnabled ? "启用" : "停用")</span></td>
            <td>@FormatTime(admin.CreatedAt)</td>
            <td class="muted">@(admin.IsPrimary ? "全局权限（受保护）" : "后台登录账号")</td>
            <td>
                <div class="actions">
                    @if (Can(PermissionCodes.IamManage) && !admin.IsPrimary)
                    {
                        <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => OpenGrantEditorAsync(admin)">
                            <i class="bi bi-shield-check"></i>
                            授权
                        </button>
                    }
                    @if (Can(PermissionCodes.AdminAccountUpdate))
                    {
                        <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => OpenEdit(admin)">
                            <i class="bi bi-pencil"></i>
                            编辑
                        </button>
                    }
                    @if (Can(PermissionCodes.AdminAccountDelete) && !admin.IsPrimary)
                    {
                        <button class="btn btn-danger admin-btn compact-action" type="button" @onclick="() => RequestDelete(admin)">
                            <i class="bi bi-trash"></i>
                            删除
                        </button>
                    }
                </div>
            </td>
        </RowTemplate>
    </ServerDataGrid>
</section>
}
else
{
    <section class="panel">
        <div class="panel-header">
            <div>
                <h2>管理员账号</h2>
                <p>当前账号没有查看管理员列表的权限。</p>
            </div>
            @if (CanCreateAdmin)
            {
                <button class="btn btn-primary admin-btn" type="button" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg"></i>
                    添加管理员
                </button>
            }
        </div>
    </section>
}

@if (_editorOpen)
{
    <div class="modal-backdrop" @onclick="CloseEditor">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>@(_editingId is null ? "添加管理员" : "编辑管理员")</h2>
                    <p>@EditorDescription</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CloseEditor"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="form-grid">
                <label class="form-field">
                    <span>管理员名称</span>
                    <input class="form-control" disabled="@_editingIsPrimary" @bind="_editorName" @bind:event="oninput" autocomplete="username" />
                </label>
                <label class="form-field">
                    <span>@(_editingId is null ? "初始密码" : "新密码，留空则不修改")</span>
                    <input class="form-control" type="password" @bind="_editorPassword" @bind:event="oninput" autocomplete="new-password" />
                </label>
                <SwitchField Label="启用账号" Description="@(_editingIsPrimary ? "初始管理员必须保持启用。" : "停用后该管理员无法登录后台。")" Disabled="@_editingIsPrimary" @bind-Value="_editorEnabled" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary admin-btn" type="button" @onclick="SaveEditorAsync">保存</button>
            </div>
        </div>
    </div>
}

@if (_pendingDelete is not null)
{
    <ConfirmationDialog Title="删除管理员"
                        Message="@($"确定删除管理员“{_pendingDelete.UserName}”吗？")"
                        Warning="该账号及其全部授权会被永久删除，此操作无法撤销。"
                        ConfirmText="确认删除"
                        OnConfirm="ConfirmDeleteAsync"
                        OnCancel="CancelDelete" />
}

@if (_grantEditorOpen)
{
    <PermissionGrantEditor Title="@_grantEditorTitle"
                           SubjectName="@_grantEditorSubject"
                           InitialGrants="@_grantEditorGrants"
                           OnSave="SaveGrantsAsync"
                           OnCancel="CloseGrantEditor" />
}

@code {
    private ServerDataGrid<AdminUserView>? _grid;
    private AdminUserStatusFilter _status = AdminUserStatusFilter.Any;
    private static readonly IReadOnlyList<AdminSelectOption<AdminUserStatusFilter>> StatusOptions =
    [
        new(AdminUserStatusFilter.Any, "全部状态"),
        new(AdminUserStatusFilter.Enabled, "启用"),
        new(AdminUserStatusFilter.Disabled, "停用")
    ];
    private bool _editorOpen;
    private Guid? _editingId;
    private string _editorName = string.Empty;
    private string _editorPassword = string.Empty;
    private bool _editorEnabled = true;
    private bool _editingIsPrimary;
    private bool _grantEditorOpen;
    private Guid? _grantEditorAdminId;
    private PendingAdminDraft? _pendingAdmin;
    private string _grantEditorTitle = string.Empty;
    private string _grantEditorSubject = string.Empty;
    private IReadOnlyList<PermissionGrantInput> _grantEditorGrants = [];
    private bool _loaded;
    private bool _accessDenied;
    private PermissionSnapshot _permissions = new();
    private AdminUserView? _pendingDelete;

    private bool CanCreateAdmin => Can(PermissionCodes.AdminAccountCreate) && Can(PermissionCodes.IamManage);
    private string EditorDescription => _editingId is null
        ? "创建新的后台登录账号。"
        : _editingIsPrimary
            ? "初始管理员的名称、状态和全局权限受保护，只能修改密码。"
            : "修改账号名称、状态或密码。";

    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _permissions = await Permissions.GetSnapshotAsync(user, CancellationToken.None);
        _accessDenied = !Can(PermissionCodes.IamManage)
                        && !CanAny(
                            PermissionCodes.AdminAccountList,
                            PermissionCodes.AdminAccountCreate,
                            PermissionCodes.AdminAccountUpdate,
                            PermissionCodes.AdminAccountDelete);
        _loaded = true;
    }

    private Task<PagedResult<AdminUserView>> LoadAdminsAsync(string search, int page, int pageSize) =>
        Can(PermissionCodes.AdminAccountList)
            ? Administration.SearchAdminUsersAsync(search, _status, page, pageSize, CancellationToken.None)
            : Task.FromResult(new PagedResult<AdminUserView>([], page, pageSize, 0));

    private async Task ReloadGridAsync()
    {
        if (_grid is not null) await _grid.RefreshAsync();
    }

    private async Task ReloadGridFirstPageAsync()
    {
        if (_grid is not null) await _grid.ReloadFromFirstPageAsync();
    }

    private async Task<string> ActorAsync() =>
        (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin-ui";

    private void OpenCreate()
    {
        if (!CanCreateAdmin)
        {
            Toasts.Error("当前账号没有创建管理员或分配授权的权限。");
            return;
        }

        _editingId = null;
        _editorName = string.Empty;
        _editorPassword = string.Empty;
        _editorEnabled = true;
        _editingIsPrimary = false;
        _editorOpen = true;
    }

    private void OpenEdit(AdminUserView admin)
    {
        if (!Can(PermissionCodes.AdminAccountUpdate))
        {
            Toasts.Error("当前账号没有编辑管理员的权限。");
            return;
        }

        _editingId = admin.Id;
        _editorName = admin.UserName;
        _editorPassword = string.Empty;
        _editorEnabled = admin.IsEnabled;
        _editingIsPrimary = admin.IsPrimary;
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _editingIsPrimary = false;
    }

    private async Task SaveEditorAsync()
    {
        try
        {
            if (_editingId is null)
            {
                if (!CanCreateAdmin)
                {
                    Toasts.Error("当前账号没有创建管理员或分配授权的权限。");
                    return;
                }

                if (string.IsNullOrWhiteSpace(_editorName) || string.IsNullOrWhiteSpace(_editorPassword))
                {
                    Toasts.Error("管理员名称和初始密码不能为空。");
                    return;
                }

                _pendingAdmin = new PendingAdminDraft(_editorName, _editorPassword, _editorEnabled);
                _grantEditorAdminId = null;
                _grantEditorTitle = "创建管理员授权";
                _grantEditorSubject = _editorName.Trim();
                _grantEditorGrants = [];
                _grantEditorOpen = true;
                return;
            }

            if (!Can(PermissionCodes.AdminAccountUpdate))
            {
                Toasts.Error("当前账号没有编辑管理员的权限。");
                return;
            }

            await Administration.UpdateAdminUserAsync(_editingId.Value, _editorName, _editorEnabled, _editorPassword, await ActorAsync(), CancellationToken.None);
            Toasts.Success("管理员已更新。");
            CloseEditor();
            await ReloadGridAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task OpenGrantEditorAsync(AdminUserView admin)
    {
        if (!Can(PermissionCodes.IamManage))
        {
            Toasts.Error("当前账号没有授权管理权限。");
            return;
        }

        try
        {
            var grants = await Permissions.GetGrantsAsync(PermissionSubjectType.AdminUser, admin.Id, CancellationToken.None);
            _pendingAdmin = null;
            _grantEditorAdminId = admin.Id;
            _grantEditorTitle = "编辑管理员授权";
            _grantEditorSubject = admin.UserName;
            _grantEditorGrants = grants.Select(x => new PermissionGrantInput(x.PermissionCode, x.ResourceType, x.ResourceKey)).ToArray();
            _grantEditorOpen = true;
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task SaveGrantsAsync(IReadOnlyList<PermissionGrantInput> grants)
    {
        try
        {
            if (_pendingAdmin is not null)
            {
                if (!CanCreateAdmin)
                {
                    Toasts.Error("当前账号没有创建管理员或分配授权的权限。");
                    return;
                }

                await Administration.CreateAdminUserAsync(
                    _pendingAdmin.UserName,
                    _pendingAdmin.Password,
                    _pendingAdmin.IsEnabled,
                    grants,
                    await ActorAsync(),
                    CancellationToken.None);
                Toasts.Success("管理员已创建。");
                _pendingAdmin = null;
                CloseEditor();
                await ReloadGridAsync();
            }
            else if (_grantEditorAdminId is not null)
            {
                if (!Can(PermissionCodes.IamManage))
                {
                    Toasts.Error("当前账号没有授权管理权限。");
                    return;
                }

                await Permissions.ReplaceGrantsAsync(
                    PermissionSubjectType.AdminUser,
                    _grantEditorAdminId.Value,
                    grants,
                    await ActorAsync(),
                    CancellationToken.None);
                Toasts.Success("管理员授权已保存。");
            }

            CloseGrantEditor();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private void RequestDelete(AdminUserView admin)
    {
        if (admin.IsPrimary)
        {
            Toasts.Error("初始管理员不能被删除。");
            return;
        }

        _pendingDelete = admin;
    }

    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (!Can(PermissionCodes.AdminAccountDelete))
        {
            Toasts.Error("当前账号没有删除管理员的权限。");
            return;
        }

        if (_pendingDelete is null) return;
        var id = _pendingDelete.Id;
        try
        {
            await Administration.DeleteAdminUserAsync(id, await ActorAsync(), CancellationToken.None);
            _pendingDelete = null;
            Toasts.Success("管理员已删除。");
            await ReloadGridAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private void CloseGrantEditor()
    {
        _grantEditorOpen = false;
        _grantEditorAdminId = null;
        _grantEditorGrants = [];
    }

    private static string FormatTime(DateTimeOffset value) => value.LocalDateTime.ToString("yyyy-MM-dd HH:mm");

    private sealed record PendingAdminDraft(string UserName, string Password, bool IsEnabled);

    private bool Can(string code) => _permissions.Has(code);
    private bool CanAny(params string[] codes) => _permissions.HasAny(codes);
}
