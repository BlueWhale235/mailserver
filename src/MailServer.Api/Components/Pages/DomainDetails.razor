    private string CertificateSummary()
    {
        if (_health is null || !_health.HasCertificate)
        {
            return "建议先配置证书";
        }

        if (_health?.CertificateNotAfter is null)
        {
            return "证书已绑定";
        }

        var days = (int)Math.Ceiling((_health.CertificateNotAfter.Value.LocalDateTime - DateTime.Now).TotalDays);
        return days < 0 ? $"{Math.Abs(days)} 天前已过期" : $"{days} 天后到期";
    }

