    protected override async Task OnParametersSetAsync()
    {
        var requested = RouteSection ?? InitialSection ?? "overview";
        _section = InternalSection(requested);
        if (_section == "domain")
        {
            _domainTab = NormalizeDomainTab(InitialTab);
        }

        var canonical = RouteSectionName(_section);
        if (RouteSection is null || !RouteSection.Equals(canonical, StringComparison.OrdinalIgnoreCase))
        {
            var tab = string.IsNullOrWhiteSpace(InitialTab) ? string.Empty : $"?tab={Uri.EscapeDataString(InitialTab)}";
            Navigation.NavigateTo($"/admin/domains/{Id}/{canonical}{tab}", replace: true);
        }
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _permissions = await Permissions.GetSnapshotAsync(user, CancellationToken.None);
        if (!CanAccessCurrentSection())
        {
            _accessDenied = true;
            return;
        }

        _accessDenied = false;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _view = await Administration.GetDomainAsync(Id, CancellationToken.None);
        _dns = await Dns.GetAsync(Id, CancellationToken.None);
        _health = await Administration.GetDomainHealthAsync(Id, CancellationToken.None);
        _accounts = await Administration.GetDomainAccountsAsync(Id, CancellationToken.None);
        _aliases = await Administration.GetDomainAliasesAsync(Id, CancellationToken.None);
        _incomingRules = await Rules.GetRulesAsync(Id, MailRuleDirection.Incoming, CancellationToken.None);
        _outgoingRules = await Rules.GetRulesAsync(Id, MailRuleDirection.Outgoing, CancellationToken.None);
        _folderCoverage = await Rules.GetFolderCoverageAsync(Id, CancellationToken.None);
        _mailboxSettings = await Administration.GetMailboxSettingsAsync(CancellationToken.None);
        _audits = await Administration.GetDomainAuditAsync(Id, CancellationToken.None);
        _mailHostName = _view.Domain.MailHostName ?? $"mail.{_view.Domain.Name}";
        _smtpHostName = _view.Domain.SmtpHostName ?? string.Empty;
        _outboundIpAddresses = _view.Domain.OutboundIpAddresses ?? string.Empty;
        _directDeliverSameDomain = _view.Domain.DirectDeliverSameDomain;
        _outboundMode = _view.Domain.OutboundMode;
        _isActive = _view.Domain.IsActive;
        _domainQuotaMiB = ToMiB(_view.Domain.QuotaBytes);
        _dkimSelector = _view.Domain.DkimSelector ?? $"s{DateTimeOffset.UtcNow:yyyyMM}";
        _certificatePath = _view.Certificate?.Source == CertificateSource.ExternalPath ? _view.Certificate.CertificatePath : string.Empty;
        _privateKeyPath = _view.Certificate?.Source == CertificateSource.ExternalPath ? _view.Certificate.PrivateKeyPath : string.Empty;
        _defaultFoldersText = string.Join(Environment.NewLine, _mailboxSettings.DefaultFolders);
    }

    private async Task ReloadFromButtonAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _busyText = _section == "queue" ? "正在刷新队列" : "正在刷新域名数据";
        try
        {
            if (_section == "queue" && _queuePanel is not null)
            {
                await _queuePanel.RefreshAsync();
                Toasts.Success("队列已刷新。");
            }
            else
            {
                await ReloadAsync();
                Toasts.Success("域名数据已刷新。");
            }
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _busy = false;
            _busyText = "正在处理";
        }
    }

    private async Task<string> ActorAsync() =>
        (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin-ui";

    private void SelectSection(string section)
    {
        Navigation.NavigateTo($"/admin/domains/{Id}/{RouteSectionName(section)}");
    }

    private void SelectDomainTab(string tab)
    {
        Navigation.NavigateTo($"/admin/domains/{Id}/domain-config?tab={Uri.EscapeDataString(NormalizeDomainTab(tab))}");
    }

    private void SetDomainTabState(string tab) => _domainTab = NormalizeDomainTab(tab);

    private static string InternalSection(string routeSection) => routeSection.Trim().ToLowerInvariant() switch
    {
        "domain" or "domainconfig" or "domain-config" => "domain",
        "accounts" => "accounts",
        "aliases" => "aliases",
        "rules" or "mail-rules" => "rules",
        "imap" or "imap-folders" => "imap",
        "queue" => "queue",
        "logs" => "logs",
        _ => "overview"
    };

    private static string RouteSectionName(string section) => section switch
    {
        "domain" => "domain-config",
        "rules" => "mail-rules",
        "imap" => "imap-folders",
        _ => section
    };

    private string SectionClass(string section) =>
        _section == section ? "domain-nav-item active" : "domain-nav-item";

    private bool CanAccessCurrentSection() => _section switch
    {
        "domain" => CanAny(
            PermissionCodes.DomainUpdate,
            PermissionCodes.DomainDnsDetail,
            PermissionCodes.DomainDnsUpdate,
            PermissionCodes.DomainCertificateDetail,
            PermissionCodes.DomainCertificateUpdate),
        "accounts" => CanAny(
            PermissionCodes.DomainAccountList,
            PermissionCodes.DomainAccountCreate,
            PermissionCodes.DomainAccountUpdate,
            PermissionCodes.DomainAccountPassword),
        "aliases" => CanAny(
            PermissionCodes.DomainAliasList,
            PermissionCodes.DomainAliasCreate,
            PermissionCodes.DomainAliasUpdate,
            PermissionCodes.DomainAliasDelete),
        "rules" => CanAny(
            PermissionCodes.DomainRuleList,
            PermissionCodes.DomainRuleCreate,
            PermissionCodes.DomainRuleUpdate,
            PermissionCodes.DomainRuleDelete,
            PermissionCodes.DomainRuleReorder),
        "imap" => Can(PermissionCodes.DomainAccountList),
        "queue" => Can(PermissionCodes.DomainRead),
        "logs" => Can(PermissionCodes.DomainAuditList),
        _ => Can(PermissionCodes.DomainDetail)
    };

    private bool Can(string code) => _permissions.Has(code, Id);
    private bool CanAny(params string[] codes) => codes.Any(Can);

    private string DomainTabClass(string tab) =>
        _domainTab == tab ? "tab-button active" : "tab-button";

    private string DomainTabPanelClass(string tab) =>
        _domainTab == tab ? "active" : string.Empty;

    private static string NormalizeDomainTab(string? tab) => tab?.Trim().ToLowerInvariant() switch
    {
        "tls" => "tls",
        "dns" => "dns",
        "connections" => "connections",
        _ => "basic"
    };

    private string AliasModeButtonClass(MailAliasMode mode) =>
        _aliasMode == mode ? "segmented-button active" : "segmented-button";

    private void SelectCertificate(InputFileChangeEventArgs args)
