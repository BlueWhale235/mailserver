        _accountModalOpen = true;
    }

    private void CloseAccountModal() => _accountModalOpen = false;

    private async Task CreateAccountAsync() => await RunAsync(async () =>
    {
        ValidateAccountQuota(_accountQuotaMiB);
        if (_accountPassword != _accountPasswordConfirm)
        {
            throw new InvalidOperationException("两次输入的初始密码不一致。");
        }

        await Administration.CreateDomainAccountAsync(
            Id,
            _accountLocalPart,
            _accountPassword,
            checked(_accountQuotaMiB * 1_048_576),
            await ActorAsync(),
            CancellationToken.None);
        _accountModalOpen = false;
        await ReloadAsync();
    }, "账号已创建。");

    private void OpenEditAccount(AccountView account)
    {
        _editingAccount = account;
        _editEnabled = account.IsEnabled;
        _editQuotaMiB = ToMiB(account.QuotaBytes);
        _editInitialEnabled = account.IsEnabled;
        _editInitialQuotaMiB = _editQuotaMiB;
        _editPassword = string.Empty;
        _editPasswordConfirm = string.Empty;
        _confirmDiscardAccountEdit = false;
    }

    private async Task SaveDomainQuotaAsync()
    {
        try
        {
            await Administration.UpdateDomainQuotaAsync(
                Id,
                checked(_domainQuotaMiB * 1_048_576),
                await ActorAsync(),
                CancellationToken.None);
            Toasts.Success("域名总配额已保存。");
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private bool IsAccountEditDirty =>
        _editingAccount is not null
        && (_editEnabled != _editInitialEnabled
            || _editQuotaMiB != _editInitialQuotaMiB
            || !string.IsNullOrWhiteSpace(_editPassword)
            || !string.IsNullOrWhiteSpace(_editPasswordConfirm));

    private void RequestCloseEditAccount()
    {
        if (IsAccountEditDirty)
        {
            _confirmDiscardAccountEdit = true;
            return;
        }

        CloseEditAccount();
    }

    private void CancelDiscardAccountEdit() => _confirmDiscardAccountEdit = false;

    private void DiscardAccountEdit()
    {
        _confirmDiscardAccountEdit = false;
        CloseEditAccount();
    }

    private void CloseEditAccount()
    {
        _editingAccount = null;
        _confirmDiscardAccountEdit = false;
    }

    private async Task SaveAccountEditAsync() => await RunAsync(async () =>
    {
        if (_editingAccount is null) return;
        ValidateAccountQuota(_editQuotaMiB, _editingAccount.UsedBytes);
        if (!string.IsNullOrWhiteSpace(_editPassword) || !string.IsNullOrWhiteSpace(_editPasswordConfirm))
        {
            if (string.IsNullOrWhiteSpace(_editPassword))
            {
                throw new InvalidOperationException("请输入新密码，或同时留空两个密码框。");
            }

            if (_editPassword != _editPasswordConfirm)
            {
                throw new InvalidOperationException("两次输入的新密码不一致。");
            }
        }

        await Administration.UpdateAccountAsync(
            _editingAccount.Id,
            _editEnabled,
            checked(_editQuotaMiB * 1_048_576),
            await ActorAsync(),
            CancellationToken.None);
        if (!string.IsNullOrWhiteSpace(_editPassword))
        {
            await Administration.SetAccountPasswordAsync(
                _editingAccount.Id,
                _editPassword,
                await ActorAsync(),
                CancellationToken.None);
        }

        _editingAccount = null;
        await ReloadAsync();
    }, "账号已保存。");

    private void AskDisableAccount(AccountView account) => _pendingDisableAccount = account;
    private void CloseDisableAccount() => _pendingDisableAccount = null;

    private async Task EnableAccountAsync(AccountView account) => await RunAsync(async () =>
    {
        await Administration.UpdateAccountAsync(
            account.Id,
            true,
            null,
            await ActorAsync(),
            CancellationToken.None);
        await ReloadAsync();
    }, "账号已启用。");

    private async Task DisableAccountAsync() => await RunAsync(async () =>
    {
        if (_pendingDisableAccount is null) return;
        await Administration.UpdateAccountAsync(
            _pendingDisableAccount.Id,
            false,
            null,
            await ActorAsync(),
            CancellationToken.None);
        _pendingDisableAccount = null;
        await ReloadAsync();
    }, "账号已停用，邮件数据已保留。");

    private void ValidateAccountQuota(long quotaMiB, long usedBytes = 0)
    {
        if (quotaMiB <= 0)
        {
            throw new InvalidOperationException("账号配额必须大于 0 MB。");
        }

        var quotaBytes = checked(quotaMiB * 1_048_576);
        if (_view is not null && quotaBytes > _view.Domain.QuotaBytes)
        {
            throw new InvalidOperationException($"账号配额不能超过域名总配额 {_domainQuotaMiB} MB。");
        }

        if (quotaBytes < usedBytes)
        {
            throw new InvalidOperationException("账号配额不能低于当前已使用容量。");
        }
    }

    private void OpenCreateAlias()
    {
        _aliasSourceLocalPart = string.Empty;
        _aliasTargetAccountId = Guid.Empty;
        _aliasMode = MailAliasMode.SendReceive;
        _selectedAliasAccount = null;
        _editingAlias = null;
        _aliasModalOpen = true;
    }

    private void OpenRebindAlias(AliasView alias)
    {
        _editingAlias = alias;
        _aliasSourceLocalPart = alias.Source.Split('@')[0];
        _aliasTargetAccountId = alias.TargetAccountId ?? Guid.Empty;
        _aliasMode = alias.Mode;
        _selectedAliasAccount = _accounts.FirstOrDefault(x => x.Id == alias.TargetAccountId);
        _aliasModalOpen = true;
    }

    private void CloseAliasModal()
    {
        _aliasModalOpen = false;
        _editingAlias = null;
    }

    private async Task SaveAliasAsync() => await RunAsync(async () =>
    {
        if (_aliasTargetAccountId == Guid.Empty && (_editingAlias is null || _aliasMode != MailAliasMode.Disabled))
            throw new InvalidOperationException("请选择绑定账号。");
        if (_editingAlias is null)
        {
            await Administration.CreateDomainAliasAsync(
                Id,
                _aliasSourceLocalPart,
                _aliasTargetAccountId,
                _aliasMode,
                await ActorAsync(),
                CancellationToken.None);
        }
        else
        {
            await Administration.UpdateAliasAsync(
                _editingAlias.Id,
                _aliasSourceLocalPart,
                _aliasTargetAccountId == Guid.Empty ? null : _aliasTargetAccountId,
                _aliasMode,
                await ActorAsync(),
                CancellationToken.None);
        }
        _aliasModalOpen = false;
        _editingAlias = null;
        await ReloadAsync();
    }, "别名绑定已保存。");

