    private static async Task<byte[]> ReadFileAsync(IBrowserFile file, int maximum)
    {
        await using var stream = file.OpenReadStream(maximum);
        await using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        return memory.ToArray();
    }

    private async Task RunAsync(Func<Task> action, string success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _busyText = "正在处理";
        try
        {
            await action();
            Toasts.Success(success);
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _busy = false;
            _busyText = "正在处理";
        }
    }
