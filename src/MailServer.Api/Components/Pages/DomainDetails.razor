    private void StartIpDrag(string ip, bool fromSelected)
    {
        _dragIp = ip;
        _dragIpFromSelected = fromSelected;
    }

    private void DropIpOnSelected(string targetIp)
    {
        if (string.IsNullOrWhiteSpace(_dragIp) || _dragIp.Equals(targetIp, StringComparison.OrdinalIgnoreCase))
        {
            ClearIpDrag();
            return;
        }

        var ips = OutboundIpItems;
        ips.RemoveAll(ip => ip.Equals(_dragIp, StringComparison.OrdinalIgnoreCase));
        var targetIndex = ips.FindIndex(ip => ip.Equals(targetIp, StringComparison.OrdinalIgnoreCase));
        if (targetIndex < 0) targetIndex = ips.Count;
        ips.Insert(targetIndex, _dragIp);
        SetOutboundIpItems(ips);
        ClearIpDrag();
    }

    private void DropIpAtEnd()
    {
        if (string.IsNullOrWhiteSpace(_dragIp)) return;
        var ips = OutboundIpItems;
        ips.RemoveAll(ip => ip.Equals(_dragIp, StringComparison.OrdinalIgnoreCase));
        ips.Add(_dragIp);
        SetOutboundIpItems(ips);
        ClearIpDrag();
    }

    private void DropIpToAvailable()
    {
        if (string.IsNullOrWhiteSpace(_dragIp))
        {
            return;
        }

        if (_dragIpFromSelected)
        {
            RemoveOutboundIp(_dragIp);
        }
        ClearIpDrag();
    }

    private void AddOutboundIp(string ip)
    {
        var ips = OutboundIpItems;
        if (!ips.Contains(ip, StringComparer.OrdinalIgnoreCase))
        {
            ips.Add(ip);
            SetOutboundIpItems(ips);
        }
    }

    private void RemoveOutboundIp(string ip)
    {
        var ips = OutboundIpItems;
        ips.RemoveAll(item => item.Equals(ip, StringComparison.OrdinalIgnoreCase));
        SetOutboundIpItems(ips);
    }

    private void MoveOutboundIp(string ip, int delta)
    {
        var ips = OutboundIpItems;
        var index = ips.FindIndex(item => item.Equals(ip, StringComparison.OrdinalIgnoreCase));
        var target = index + delta;
        if (index < 0 || target < 0 || target >= ips.Count) return;
        ips.RemoveAt(index);
        ips.Insert(target, ip);
        SetOutboundIpItems(ips);
    }

    private void SetOutboundIpItems(IEnumerable<string> ips)
    {
        _outboundIpAddresses = string.Join(
            Environment.NewLine,
            ips.Where(ip => !string.IsNullOrWhiteSpace(ip))
                .Select(ip => ip.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private void SetOutboundIpItemsFromComponent(IReadOnlyList<string> ips) => SetOutboundIpItems(ips);

    private void ClearIpDrag()
    {
        _dragIp = null;
        _dragIpFromSelected = false;
    }

    private static MailRuleOperator[] OperatorsFor(MailRuleField field) => field switch
    {
        MailRuleField.MessageSize => [MailRuleOperator.GreaterThan, MailRuleOperator.GreaterThanOrEqual, MailRuleOperator.LessThan, MailRuleOperator.LessThanOrEqual],
        MailRuleField.MessageTime => [MailRuleOperator.Before, MailRuleOperator.After, MailRuleOperator.Between],
        MailRuleField.HasAttachment => [MailRuleOperator.Is],
        _ => [MailRuleOperator.ContainsAny, MailRuleOperator.ContainsAll, MailRuleOperator.EqualsAny, MailRuleOperator.NotContainsAny]
    };

    private static string RuleFieldText(MailRuleField field) => field switch
    {
        MailRuleField.Sender => "发件人",
        MailRuleField.SenderDomain => "发件域",
        MailRuleField.Recipient => "收件人",
        MailRuleField.Cc => "抄送人",
        MailRuleField.RecipientOrCc => "收件人或抄送人",
        MailRuleField.Subject => "主题",
        MailRuleField.Body => "正文",
        MailRuleField.AttachmentName => "附件名",
        MailRuleField.MessageSize => "邮件大小",
        MailRuleField.MessageTime => "收发时间",
        MailRuleField.HasAttachment => "有附件",
        _ => field.ToString()
    };

    private static string RuleOperatorText(MailRuleOperator operation) => operation switch
    {
        MailRuleOperator.ContainsAny => "包含任一",
        MailRuleOperator.ContainsAll => "包含全部",
        MailRuleOperator.EqualsAny => "等于任一",
        MailRuleOperator.NotContainsAny => "不包含",
        MailRuleOperator.GreaterThan => "大于",
        MailRuleOperator.GreaterThanOrEqual => "大于等于",
        MailRuleOperator.LessThan => "小于",
        MailRuleOperator.LessThanOrEqual => "小于等于",
        MailRuleOperator.Before => "早于",
        MailRuleOperator.After => "晚于",
        MailRuleOperator.Between => "介于",
        MailRuleOperator.Is => "是否",
        _ => operation.ToString()
    };

    private sealed record RuleDraft
    {
        public string Name { get; set; } = string.Empty;
        public MailRuleMatchMode MatchMode { get; set; } = MailRuleMatchMode.All;
        public string TargetMailboxName { get; set; } = "INBOX";
        public bool MoveEnabled { get; set; } = true;
        public List<string> ForwardTargets { get; set; } = [];
        public bool IsEnabled { get; set; } = true;
        public List<RuleConditionDraft> Conditions { get; init; } = [];

        public static RuleDraft CreateDefault() => new()
        {
            Conditions = [RuleConditionDraft.CreateDefault()]
        };

        public static RuleDraft From(MailRuleView rule) => new()
        {
            Name = rule.Name,
            MatchMode = rule.MatchMode,
            TargetMailboxName = rule.TargetMailboxName,
            MoveEnabled = rule.Actions.Count == 0 || rule.Actions.Any(x => x.Kind == MailRuleActionKind.MoveToFolder),
            ForwardTargets = rule.Actions.Where(x => x.Kind == MailRuleActionKind.ForwardTo).SelectMany(x => x.Values).Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
            IsEnabled = rule.IsEnabled,
            Conditions = rule.Conditions.Select(RuleConditionDraft.From).ToList()
        };

        public MailRuleInput ToInput(MailRuleDirection direction)
        {
            var actions = new List<MailRuleActionInput>();
            if (direction == MailRuleDirection.Outgoing || MoveEnabled)
                actions.Add(new MailRuleActionInput(MailRuleActionKind.MoveToFolder, [TargetMailboxName]));
            if (direction == MailRuleDirection.Incoming && ForwardTargets.Count > 0)
                actions.Add(new MailRuleActionInput(MailRuleActionKind.ForwardTo, ForwardTargets));
            return new MailRuleInput(
                Name,
                direction,
                MatchMode,
                TargetMailboxName,
                IsEnabled,
                Conditions.Select(x => x.ToInput()).ToArray(),
                actions);
        }
    }

    private sealed class RuleConditionDraft
    {
        public Guid Key { get; } = Guid.NewGuid();
        public MailRuleField Field { get; set; } = MailRuleField.Sender;
        public MailRuleOperator Operator { get; set; } = MailRuleOperator.ContainsAny;
        public List<string> Tokens { get; set; } = [];
        public decimal SizeValue { get; set; }
        public string SizeUnit { get; set; } = "KB";
        public DateTime? FirstTime { get; set; }
        public DateTime? SecondTime { get; set; }
        public string BooleanValue { get; set; } = "true";

        public static RuleConditionDraft CreateDefault() => new();

        public static RuleConditionDraft From(MailRuleConditionView condition)
        {
            var draft = new RuleConditionDraft
            {
                Field = condition.Field,
                Operator = condition.Operator,
                Tokens = condition.Values.ToList()
            };
            if (condition.Field == MailRuleField.MessageSize
                && long.TryParse(condition.Values.FirstOrDefault(), out var bytes))
            {
                draft.SizeUnit = bytes >= 1_048_576 ? "MB" : "KB";
                draft.SizeValue = draft.SizeUnit == "MB" ? bytes / 1_048_576m : bytes / 1024m;
            }
            else if (condition.Field == MailRuleField.MessageTime)
            {
                if (DateTimeOffset.TryParse(condition.Values.ElementAtOrDefault(0), out var first)) draft.FirstTime = first.LocalDateTime;
                if (DateTimeOffset.TryParse(condition.Values.ElementAtOrDefault(1), out var second)) draft.SecondTime = second.LocalDateTime;
            }
            else if (condition.Field == MailRuleField.HasAttachment)
            {
                draft.BooleanValue = condition.Values.FirstOrDefault() ?? "true";
            }
            return draft;
        }

        public MailRuleConditionInput ToInput()
        {
            IReadOnlyList<string> values;
            if (Field == MailRuleField.MessageSize)
            {
                var multiplier = SizeUnit == "MB" ? 1_048_576m : 1024m;
                values = [decimal.ToInt64(decimal.Round(SizeValue * multiplier, 0)).ToString()];
            }
            else if (Field == MailRuleField.MessageTime)
            {
                if (FirstTime is null) throw new FormatException("请选择规则时间。");
                var list = new List<string> { new DateTimeOffset(FirstTime.Value).ToUniversalTime().ToString("O") };
                if (Operator == MailRuleOperator.Between)
                {
                    if (SecondTime is null) throw new FormatException("请选择时间区间的结束时间。");
                    list.Add(new DateTimeOffset(SecondTime.Value).ToUniversalTime().ToString("O"));
                }
                values = list;
            }
            else if (Field == MailRuleField.HasAttachment)
            {
                values = [BooleanValue];
            }
            else
            {
                values = Tokens;
            }
            return new MailRuleConditionInput(Field, Operator, values);
        }
    }

