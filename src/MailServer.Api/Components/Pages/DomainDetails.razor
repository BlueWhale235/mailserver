    private static string RuleSummary(MailRuleView rule)
    {
        var joiner = rule.MatchMode == MailRuleMatchMode.All ? " 且 " : " 或 ";
        var conditions = string.Join(joiner, rule.Conditions.Select(condition =>
            $"{RuleFieldText(condition.Field)} {RuleOperatorText(condition.Operator)} {FormatConditionValues(condition)}"));
        var actions = rule.Actions.Count == 0
            ? $"移动到 {rule.TargetMailboxName}"
            : string.Join("，", rule.Actions.Select(action => action.Kind == MailRuleActionKind.MoveToFolder
                ? $"移动到 {action.Values.FirstOrDefault()}"
                : $"转发到 {string.Join("、", action.Values)}"));
        return $"如果 {conditions}，则{actions}";
    }

    private static string FormatConditionValues(MailRuleConditionView condition)
    {
        if (condition.Field == MailRuleField.MessageSize && long.TryParse(condition.Values.FirstOrDefault(), out var bytes))
            return bytes >= 1_048_576 ? $"{bytes / 1_048_576d:0.##} MB" : $"{bytes / 1024d:0.##} KB";
        if (condition.Field == MailRuleField.HasAttachment)
            return condition.Values.FirstOrDefault() == "true" ? "有附件" : "无附件";
        return string.Join("、", condition.Values);
    }

