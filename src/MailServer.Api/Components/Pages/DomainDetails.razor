    private long _accountQuotaMiB = 1024;
    private long _domainQuotaMiB = 10240;
    private AccountView? _editingAccount;
    private bool _editEnabled;
    private bool _editInitialEnabled;
    private long _editInitialQuotaMiB;
    private long _editQuotaMiB;
