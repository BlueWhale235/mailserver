@page "/admin/domains/{Id:guid}"
@page "/admin/domains/{Id:guid}/{RouteSection}"
@layout MailServer.Api.Components.Layout.DomainLayout
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject DomainCertificateService Certificates
@inject DomainDnsService Dns
@inject MailRuleService Rules
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JavaScript
@inject AdminToastService Toasts
@inject NavigationManager Navigation
@inject PermissionService Permissions

<PageTitle>域名管理</PageTitle>

@if (_accessDenied)
{
    <AccessDeniedPanel />
}
else if (_view is null || _dns is null || _health is null || _mailboxSettings is null)
{
    <p>正在加载...</p>
}
else
{
    <div class="domain-workbench">
        <div class="domain-workbench-header">
            <div>
                <div class="breadcrumb"><a href="/admin/domains">域名管理</a><span>/</span><strong>@_view.Domain.Name</strong></div>
                <div class="domain-title-line">
                    <h1>@_view.Domain.Name</h1>
                    <span class="status-pill domain-status-pill @(_view.Domain.IsActive ? "status-enabled" : "status-disabled")">
                        域名：@(_view.Domain.IsActive ? "活动" : "停用")
                    </span>
                    <span class="status-pill tls-status-pill @(_health.HasCertificate ? "status-enabled" : "status-warning")">
                        TLS：@(_health.HasCertificate ? "已配置" : "未配置")
                    </span>
                </div>
                <p>集中管理该域名的配置、账号、别名、默认文件夹和最近操作记录。</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-outline-primary admin-btn" type="button" disabled="@_busy" @onclick="ReloadFromButtonAsync">刷新</button>
            </div>
        </div>

        <div class="domain-workbench-layout">
            <main class="domain-workbench-body">
                <PanelLoadingOverlay Visible="@_busy" Text="@_busyText" />
                @if (_section == "overview")
                {
                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>域名概览</h2>
                                <p>用一屏确认这个域名是否已经具备收发信、客户端连接和账号管理的基础条件。</p>
                            </div>
                        </div>
                        <div class="domain-stat-grid">
                            <div class="domain-stat @(_health.EnabledAccountCount > 0 ? "stat-ok" : "stat-warning")">
                                <span class="domain-stat-label"><i class="bi bi-person-check"></i>账号</span>
                                <strong>@_health.EnabledAccountCount / @_health.AccountCount</strong>
                                <small>启用账号 / 全部账号</small>
                            </div>
                            <div class="domain-stat stat-info">
                                <span class="domain-stat-label"><i class="bi bi-at"></i>别名</span>
                                <strong>@_health.AliasCount</strong>
                                <small>当前同域身份</small>
                            </div>
                            <div class="domain-stat @(_health.HasCertificate ? "stat-ok" : "stat-warning")">
                                <span class="domain-stat-label"><i class="bi bi-shield-lock"></i>TLS 证书</span>
                                <strong>@(_health.HasCertificate ? "已启用" : "未启用")</strong>
                                <small>@CertificateSummary()</small>
                            </div>
                            <div class="domain-stat @(_health.HasDkim ? "stat-ok" : "stat-warning")">
                                <span class="domain-stat-label"><i class="bi bi-key"></i>DKIM</span>
                                <strong>@(_health.HasDkim ? "已生成" : "未生成")</strong>
                                <small>@(_view.Domain.DkimSelector ?? "尚未设置 selector")</small>
                            </div>
                            <div class="domain-stat @(_health.PendingDeliveries > 0 ? "stat-notice" : "stat-ok")">
                                <span class="domain-stat-label"><i class="bi bi-send"></i>待投递</span>
                                <strong>@_health.PendingDeliveries</strong>
                                <small>待处理 / 延迟重试</small>
                            </div>
                            <div class="domain-stat @(_health.FailedDeliveries > 0 ? "stat-danger" : "stat-ok")">
                                <span class="domain-stat-label"><i class="bi bi-exclamation-octagon"></i>失败投递</span>
                                <strong>@_health.FailedDeliveries</strong>
                                <small>需要排查的队列</small>
                            </div>
                        </div>
                    </section>

                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>建议配置顺序</h2>
                                <p>按这个顺序处理，基本能覆盖邮箱系统里最常见的域名开通流程。</p>
                            </div>
                        </div>
                        <div class="checklist-grid">
                            <button type="button" class="checklist-item" @onclick="@(() => SelectDomainTab("basic"))">
                                <span class="check-status-icon @(_view.Domain.IsActive ? "status-enabled" : "status-warning")"><i class="bi @(_view.Domain.IsActive ? "bi-check2" : "bi-exclamation-lg")"></i></span>
                                <strong>确认基本信息</strong>
                                <small>邮件服务主机名和启用状态。</small>
                            </button>
                            <button type="button" class="checklist-item" @onclick="@(() => SelectDomainTab("tls"))">
                                <span class="check-status-icon @(_health.HasCertificate ? "status-enabled" : "status-warning")"><i class="bi @(_health.HasCertificate ? "bi-check2" : "bi-exclamation-lg")"></i></span>
                                <strong>配置 TLS 证书</strong>
                                <small>支持 STARTTLS、隐式 TLS 和无 SNI 回退。</small>
                            </button>
                            <button type="button" class="checklist-item" @onclick="@(() => SelectDomainTab("dns"))">
                                <span class="check-status-icon @(_health.HasDkim ? "status-enabled" : "status-warning")"><i class="bi @(_health.HasDkim ? "bi-check2" : "bi-exclamation-lg")"></i></span>
                                <strong>发布 SPF / DKIM / DMARC</strong>
                                <small>降低退信和垃圾箱概率。</small>
                            </button>
                            <button type="button" class="checklist-item" @onclick="@(() => SelectSection("accounts"))">
                                <span class="check-status-icon @(_health.AccountCount > 0 ? "status-enabled" : "status-warning")"><i class="bi @(_health.AccountCount > 0 ? "bi-check2" : "bi-exclamation-lg")"></i></span>
                                <strong>创建邮箱账号</strong>
                                <small>为每个账号设置密码和邮箱容量。</small>
                            </button>
                            <button type="button" class="checklist-item" @onclick="@(() => SelectSection("aliases"))">
                                <span class="check-status-icon @(_health.AliasCount > 0 ? "status-enabled" : "status-warning")"><i class="bi @(_health.AliasCount > 0 ? "bi-check2" : "bi-exclamation-lg")"></i></span>
                                <strong>配置同域别名</strong>
                                <small>让账号使用 sales、support 等业务身份。</small>
                            </button>
                            <button type="button" class="checklist-item" @onclick="@(() => SelectDomainTab("connections"))">
                                <span class="check-status-icon status-enabled"><i class="bi bi-check2"></i></span>
                                <strong>复制客户端参数</strong>
                                <small>给 Thunderbird、Outlook、QQ 第三方客户端使用。</small>
                            </button>
                        </div>
                    </section>
                }
                else if (_section == "domain")
                {
                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>域名配置</h2>
                                <p>基本信息、TLS、DNS 和连接方式现在放在同一个配置流里。</p>
                            </div>
                        </div>
                        <div class="tab-strip" role="tablist" data-admin-tab-group="domain-config" data-admin-tab-query-param="tab">
                            <button type="button" class="@DomainTabClass("basic")" role="tab" aria-selected="@(_domainTab == "basic")" data-admin-tab-button="domain-config" data-tab-value="basic" @onclick="@(() => SetDomainTabState("basic"))">基本信息</button>
                            <button type="button" class="@DomainTabClass("tls")" role="tab" aria-selected="@(_domainTab == "tls")" data-admin-tab-button="domain-config" data-tab-value="tls" @onclick="@(() => SetDomainTabState("tls"))">TLS 配置</button>
                            <button type="button" class="@DomainTabClass("dns")" role="tab" aria-selected="@(_domainTab == "dns")" data-admin-tab-button="domain-config" data-tab-value="dns" @onclick="@(() => SetDomainTabState("dns"))">DNS 配置</button>
                            <button type="button" class="@DomainTabClass("connections")" role="tab" aria-selected="@(_domainTab == "connections")" data-admin-tab-button="domain-config" data-tab-value="connections" @onclick="@(() => SetDomainTabState("connections"))">连接方式</button>
                        </div>

                        <div class="tab-panel @DomainTabPanelClass("basic")" role="tabpanel" data-admin-tab-panel="domain-config" data-tab-value="basic" hidden="@(_domainTab != "basic")">
                                <div class="panel-header compact-header">
                                    <div>
                                        <h3>基本信息</h3>
                                        <p>设置邮件客户端连接时使用的主机名和域名启用状态。</p>
                                    </div>
                                </div>
                                <div class="form-grid two-column compact-domain-basic">
                                    <label>邮件服务主机名
                                        <input @bind="_mailHostName" placeholder="mail.example.com" />
                                    </label>
                                    <SwitchField Label="启用域名" Description="停用后该域名不再接收或发送邮件。" @bind-Value="_isActive" />
                                </div>
                                <div class="panel-actions">
                                    <button class="btn btn-primary admin-btn" type="button" @onclick="SaveBasicDetailsAsync">保存基本信息</button>
                                </div>
                        </div>

                        <div class="tab-panel @DomainTabPanelClass("tls")" role="tabpanel" data-admin-tab-panel="domain-config" data-tab-value="tls" hidden="@(_domainTab != "tls")">
                                <div class="panel-header compact-header">
                                    <div>
                                        <h3>TLS 证书</h3>
                                        <p>证书需要覆盖 <code>@_mailHostName</code>，用于 SMTP/IMAP 的 STARTTLS 和隐式 TLS。</p>
                                    </div>
                                    <button class="btn btn-outline-primary admin-btn" type="button" @onclick="SetDefaultTlsHostAsync">设为默认 TLS 主机</button>
                                </div>
                                <p class="muted">默认 TLS 主机用于旧客户端或服务器间 STARTTLS 没有携带 SNI 的场景。</p>

                                @if (_view.Certificate is not null)
                                {
                                    <div class="definition-grid">
                                        <strong>来源</strong><span>@_view.Certificate.Source</span>
                                        <strong>主题</strong><span>@_view.Certificate.Subject</span>
                                        <strong>颁发者</strong><span>@_view.Certificate.Issuer</span>
                                        <strong>SAN</strong><span>@_view.Certificate.SubjectAlternativeNames.Replace("\n", ", ")</span>
                                        <strong>指纹</strong><code>@_view.Certificate.Thumbprint</code>
                                        <strong>有效期</strong><span>@_view.Certificate.NotBefore.ToString("u") 至 @_view.Certificate.NotAfter.ToString("u")</span>
                                    </div>
                                    <div class="toolbar">
                                        <button class="btn btn-danger admin-btn" type="button" @onclick="DeleteCertificateAsync">删除证书</button>
                                    </div>
                                }

                                <div class="section-split">
                                    <div>
                                        <h3>上传 PEM</h3>
                                        <div class="form-grid">
                                            <label class="file-upload-field"><span class="config-help" data-help="上传包含完整签发链的 PEM 证书，证书必须覆盖邮件主机名。">证书链，最大 1 MB</span>
                                                <InputFile class="form-control native-file-upload" OnChange="SelectCertificate" accept=".pem,.crt,.cer" />
                                                @if (_certificateFile is not null) { <small>@_certificateFile.Name</small> }
                                            </label>
                                            <label class="file-upload-field"><span class="config-help" data-help="私钥仅保存在服务器配置目录中，不会显示在页面或 API 响应中。">私钥，最大 256 KB</span>
                                                <InputFile class="form-control native-file-upload" OnChange="SelectPrivateKey" accept=".pem,.key" />
                                                @if (_privateKeyFile is not null) { <small>@_privateKeyFile.Name</small> }
                                            </label>
                                            <label class="file-upload-field"><span class="config-help" data-help="仅在私钥本身经过密码加密时填写。">私钥密码，如有</span>
                                                <input type="password" @bind="_privateKeyPassword" />
                                            </label>
                                        </div>
                                        <div class="toolbar">
                                            <button class="btn btn-outline-primary admin-btn" type="button" @onclick="InspectUploadAsync" disabled="@(_certificateFile is null || _privateKeyFile is null)">解析预览</button>
                                            <button class="btn btn-primary admin-btn" type="button" @onclick="SaveUploadAsync" disabled="@(_certificateFile is null || _privateKeyFile is null)">上传并启用</button>
                                        </div>
                                    </div>

                                    <div>
                                        <h3>服务器文件路径</h3>
                                        <div class="form-grid">
                                            <label>证书链绝对路径
                                                <input @bind="_certificatePath" />
                                            </label>
                                            <label>私钥绝对路径
                                                <input @bind="_privateKeyPath" />
                                            </label>
                                        </div>
                                        <div class="toolbar">
                                            <button class="btn btn-outline-primary admin-btn" type="button" @onclick="InspectPathAsync">解析预览</button>
                                            <button class="btn btn-primary admin-btn" type="button" @onclick="BindPathAsync">绑定并启用</button>
                                        </div>
                                    </div>
                                </div>

                                @if (_inspection is not null)
                                {
                                    <div class="secret">
                                        <strong>解析结果</strong>
                                        <div class="definition-grid">
                                            <strong>主题</strong><span>@_inspection.Subject</span>
                                            <strong>SAN</strong><span>@string.Join(", ", _inspection.SubjectAlternativeNames)</span>
                                            <strong>有效期</strong><span>@_inspection.NotBefore.ToString("u") 至 @_inspection.NotAfter.ToString("u")</span>
                                            <strong>覆盖邮件主机</strong><span>@(_inspection.CoversMailHostName ? "是" : "否")</span>
                                            <strong>服务器认证用途</strong><span>@(_inspection.SupportsServerAuthentication ? "是" : "否")</span>
                                            <strong>私钥匹配</strong><span>@(_inspection.HasMatchingPrivateKey ? "是" : "否")</span>
                                        </div>
                                    </div>
                                }
                        </div>

                        <div class="tab-panel @DomainTabPanelClass("dns")" role="tabpanel" data-admin-tab-panel="domain-config" data-tab-value="dns" hidden="@(_domainTab != "dns")">
                                <div class="panel-header compact-header">
                                    <div>
                                        <h3>SPF、DMARC 与 DKIM</h3>
                                        <p>生成可发布到 DNS 服务商的 TXT 记录，并验证线上状态。</p>
                                    </div>
                                </div>
                                <div class="toolbar">
                                    <button class="btn btn-outline-primary admin-btn" type="button" @onclick="ApplyDirectMxPreset">Direct MX SPF 预设</button>
                                    <button class="btn btn-outline-primary admin-btn" type="button" @onclick="ApplyRelayPreset">外部 Relay SPF 预设</button>
                                    <span class="muted">也可以直接修改字段形成自定义策略。</span>
                                </div>

                                <div class="form-grid two-column">
                                    <label class="checkbox"><input type="checkbox" @bind="_dns.Settings.SpfIncludeMx" /> SPF 包含 MX</label>
                                    <label class="checkbox"><input type="checkbox" @bind="_dns.Settings.SpfIncludeA" /> SPF 包含 A/AAAA</label>
                                    <label>IPv4，逗号或换行分隔<textarea @bind="_dns.Settings.SpfIpv4"></textarea></label>
                                    <label>IPv6，逗号或换行分隔<textarea @bind="_dns.Settings.SpfIpv6"></textarea></label>
                                    <label>include 域名<textarea @bind="_dns.Settings.SpfIncludes"></textarea></label>
                                    <label>自定义 SPF 机制<textarea @bind="_dns.Settings.SpfCustomMechanisms"></textarea></label>
                                    <label>SPF all 策略
                                        <SelectDropdown TValue="string" @bind-Value="_dns.Settings.SpfAllPolicy"
                                                        Options="SpfAllPolicyOptions" AriaLabel="SPF all 策略" />
                                    </label>
                                    <label>DMARC 策略
                                        <SelectDropdown TValue="string" @bind-Value="_dns.Settings.DmarcPolicy"
                                                        Options="DmarcPolicyOptions" AriaLabel="DMARC 策略" />
                                    </label>
                                    <label>子域策略
                                        <SelectDropdown TValue="string" @bind-Value="_dns.Settings.DmarcSubdomainPolicy"
                                                        Options="DmarcSubdomainPolicyOptions" Placeholder="继承主策略" AriaLabel="子域策略" />
                                    </label>
                                    <label>应用百分比
                                        <input type="number" min="0" max="100" @bind="_dns.Settings.DmarcPercentage" />
                                    </label>
                                    <label>聚合报告 rua<textarea @bind="_dns.Settings.DmarcAggregateReportUris" placeholder="mailto:dmarc@example.com"></textarea></label>
                                    <label>取证报告 ruf<textarea @bind="_dns.Settings.DmarcForensicReportUris"></textarea></label>
                                    <label>DKIM 对齐
                                        <SelectDropdown TValue="string" @bind-Value="_dns.Settings.DmarcDkimAlignment"
                                                        Options="AlignmentOptions" AriaLabel="DKIM 对齐" />
                                    </label>
                                    <label>SPF 对齐
                                        <SelectDropdown TValue="string" @bind-Value="_dns.Settings.DmarcSpfAlignment"
                                                        Options="AlignmentOptions" AriaLabel="SPF 对齐" />
                                    </label>
                                    <label>失败报告 fo
                                        <input @bind="_dns.Settings.DmarcFailureOptions" />
                                    </label>
                                    <label>MTA-STS 模式
                                        <select @bind="_dns.Settings.MtaStsMode">
                                            <option value="none">none</option>
                                            <option value="testing">testing</option>
                                            <option value="enforce">enforce</option>
                                        </select>
                                    </label>
                                    <label>MTA-STS 策略 ID
                                        <input maxlength="32" @bind="_dns.Settings.MtaStsPolicyId" />
                                    </label>
                                    <label>MTA-STS max_age（秒）
                                        <input type="number" min="0" max="31557600" @bind="_dns.Settings.MtaStsMaxAgeSeconds" />
                                    </label>
                                    <label>MTA-STS MX 模式
                                        <textarea @bind="_dns.Settings.MtaStsMxPatterns" placeholder="mail.example.com"></textarea>
                                    </label>
                                    <label>TLS-RPT rua
                                        <textarea @bind="_dns.Settings.TlsReportUris" placeholder="mailto:tls-reports@example.com"></textarea>
                                    </label>
                                    <label class="checkbox"><input type="checkbox" @bind="_dns.Settings.DaneEnabled" /> 发布 DANE TLSA</label>
                                    <label>TLSA 记录（每行一条）
                                        <textarea @bind="_dns.Settings.DaneTlsaRecords" placeholder="3 1 1 SHA256摘要"></textarea>
                                    </label>
                                </div>

                                <h3>应发布的 DNS 记录</h3>
                                @foreach (var record in _dns.Records)
                                {
                                    <div class="dns-record">
                                        <strong>@record.Name @record.Type</strong>
                                        <textarea readonly>@record.Value</textarea>
                                        <div class="toolbar">
                                            <button class="btn btn-outline-primary admin-btn" type="button" @onclick="() => CopyAsync(record.Value)">复制记录值</button>
                                        </div>
                                        <details><summary>Zone file 格式</summary><code>@record.ZoneFileValue</code></details>
                                    </div>
                                }

                                @if (_validation is not null)
                                {
                                    <h3>在线验证结果</h3>
                                    <div class="table-wrap">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>记录</th>
                                                    <th>状态</th>
                                                    <th>期望</th>
                                                    <th>实际</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var item in _validation.Items)
                                            {
                                                <tr>
                                                    <td>@item.Name</td>
                                                    <td><span class="status-pill status-@item.Status">@DnsValidationStatusText(item.Status)</span></td>
                                                    <td>@item.Expected</td>
                                                    <td>@string.Join(" | ", item.Actual)</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                    @foreach (var warning in _validation.Warnings)
                                    {
                                        <p class="warning">@warning</p>
                                    }
                                }
                                <div class="panel-actions dns-panel-actions">
                                    <input class="form-control dkim-selector-input" @bind="_dkimSelector" placeholder="selector，例如 s202606" />
                                    <button class="btn btn-outline-primary admin-btn" type="button" @onclick="GenerateDkimAsync">生成 RSA 2048 DKIM</button>
                                    <button class="btn btn-outline-primary admin-btn" type="button" @onclick="ValidateDnsAsync">在线验证 DNS</button>
                                    <button class="btn btn-primary admin-btn" type="button" @onclick="SaveDnsAsync">保存并生成记录</button>
                                </div>
                        </div>

                        <div class="tab-panel @DomainTabPanelClass("connections")" role="tabpanel" data-admin-tab-panel="domain-config" data-tab-value="connections" hidden="@(_domainTab != "connections")">
                                <div class="panel-header compact-header">
                                    <div>
                                        <h3>客户端连接方式</h3>
                                        <p>给 Thunderbird、Outlook、QQ 第三方客户端等使用的连接参数。</p>
                                    </div>
                                </div>
                                <p class="warning">SMTP 25/587 使用 STARTTLS 时需要有效邮件证书；465/993 为隐式 TLS。</p>
                                <div class="table-wrap">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>协议</th>
                                                <th>主机</th>
                                                <th>端口</th>
                                                <th>安全方式</th>
                                                <th>用户名</th>
                                                <th>说明</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var connection in _view.Connections)
                                        {
                                            <tr>
                                                <td>@connection.Protocol</td>
                                                <td>@connection.HostName</td>
                                                <td>@connection.Port</td>
                                                <td>@connection.Security</td>
                                                <td>@connection.UserNameFormat</td>
                                                <td>@connection.Description</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                        </div>
                    </section>
                }
                else if (_section == "accounts")
                {
                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>账号配置</h2>
                                <p>账号只填写 @@ 前缀，系统会自动使用 <strong>@@@_view.Domain.Name</strong> 作为后缀。停用账号会阻止登录和收发，但会保留邮箱数据。</p>
                            </div>
                            <button class="btn btn-primary admin-btn" type="button" @onclick="OpenCreateAccount">添加账号</button>
                        </div>
                        <div class="domain-quota-panel">
                            <div class="domain-quota-copy">
                                <h3>域名总配额</h3>
                                <p>限制该域名下全部邮箱账号合计可使用的容量。</p>
                            </div>
                            <div class="quota-summary-card">
                                <QuotaProgress UsedBytes="DomainUsedBytes"
                                               QuotaBytes="@_view.Domain.QuotaBytes"
                                               AriaLabel="域名配额使用率" />
                                <small>当前所有账号实际占用容量</small>
                            </div>
                            <div class="quota-editor-card">
                                <label class="form-field">
                                    <span>总配额（MB）</span>
                                    <input class="form-control" type="number" min="1" @bind="_domainQuotaMiB" />
                                </label>
                                <div class="panel-actions domain-quota-actions">
                                    <button class="btn btn-primary admin-btn" type="button" @onclick="SaveDomainQuotaAsync">保存配额</button>
                                </div>
                            </div>
                            @if (AccountsOverDomainQuota.Count > 0)
                            {
                                <div class="inline-warning domain-quota-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <span>有 @AccountsOverDomainQuota.Count 个账号配额超过域名总配额，请先调低账号配额或提高域名总配额。</span>
                                </div>
                            }
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>邮箱地址</th>
                                        <th>状态</th>
                                        <th>配额</th>
                                        <th>创建时间</th>
                                        <th class="actions-cell">操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (_accounts.Count == 0)
                                {
                                    <tr><td colspan="5" class="empty-cell">这个域名还没有账号。</td></tr>
                                }
                                else
                                {
                                    @foreach (var account in _accounts)
                                    {
                                        <tr>
                                            <td><strong>@account.Address</strong></td>
                                            <td><span class="status-pill @(account.IsEnabled ? "status-enabled" : "status-disabled")">@(account.IsEnabled ? "启用" : "停用")</span></td>
                                            <td>
                                                <QuotaProgress UsedBytes="account.UsedBytes" QuotaBytes="account.QuotaBytes" Compact="true" AriaLabel="@($"{account.Address} 配额使用率")" />
                                                @if (_view is not null && account.QuotaBytes > _view.Domain.QuotaBytes)
                                                {
                                                    <small class="field-hint field-hint-danger">账号配额超过域名总配额</small>
                                                }
                                            </td>
                                            <td>@account.CreatedAt.LocalDateTime</td>
                                            <td class="actions">
                                                <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => OpenEditAccount(account)">编辑</button>
                                                @if (account.IsEnabled)
                                                {
                                                    <button class="btn btn-outline-danger admin-btn compact-action" type="button" @onclick="() => AskDisableAccount(account)">停用</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary admin-btn compact-action" type="button" @onclick="() => EnableAccountAsync(account)">启用</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
                else if (_section == "aliases")
                {
                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>别名配置</h2>
                                <p>别名绑定到同域真实账号，可配置双向收发、仅收信或停用。</p>
                            </div>
                            <button class="btn btn-primary admin-btn" type="button" @onclick="OpenCreateAlias">添加别名</button>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>来源地址</th>
                                        <th>绑定账号</th>
                                        <th>状态</th>
                                        <th class="actions-cell">操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (_aliases.Count == 0)
                                {
                                    <tr><td colspan="4" class="empty-cell">这个域名还没有别名。</td></tr>
                                }
                                else
                                {
                                    @foreach (var alias in _aliases)
                                    {
                                        <tr>
                                            <td><strong>@alias.Source</strong></td>
                                            <td>@(alias.TargetAddress ?? alias.LegacyDestinationAddress ?? "未绑定")</td>
                                            <td><span class="status-pill @AliasStatusClass(alias)">@AliasModeText(alias)</span></td>
                                            <td class="actions">
                                                <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => OpenRebindAlias(alias)">编辑</button>
                                                <button class="btn btn-danger admin-btn compact-action" type="button" @onclick="() => DeleteAliasAsync(alias.Id)">删除</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
                else if (_section == "rules")
                {
                    <section class="panel mail-rules-panel">
                        <div class="panel-header">
                            <div><h2>收发信设置</h2><p>收信规则用于分类、转发和移动邮件；发信设置用于控制对外投递身份、源 IP 与同域投递策略。</p></div>
                            @if (_ruleDirection == MailRuleDirection.Incoming)
                            {
                                <button class="btn btn-primary admin-btn" type="button" @onclick="OpenCreateRule"><AdminIcon Name="plus" />新建规则</button>
                            }
                        </div>
                        <div class="tab-strip" role="tablist">
                            <button type="button" class="@RuleTabClass(MailRuleDirection.Incoming)" @onclick="() => SelectRuleTab(MailRuleDirection.Incoming)">收信规则 (@_incomingRules.Count)</button>
                            <button type="button" class="@RuleTabClass(MailRuleDirection.Outgoing)" @onclick="() => SelectRuleTab(MailRuleDirection.Outgoing)">发信设置</button>
                        </div>
                        @if (_ruleDirection == MailRuleDirection.Incoming)
                        {
                            <div class="rule-list">
                                @if (_incomingRules.Count == 0)
                                {
                                    <div class="rule-empty">暂无收信规则。</div>
                                }
                                else
                                {
                                    @foreach (var rule in _incomingRules)
                                    {
                                        <div class="rule-row" draggable="true" @ondragstart="() => StartRuleDrag(rule.Id)" @ondragover:preventDefault @ondrop="() => DropRuleAsync(rule.Id)">
                                            <span class="rule-grip" title="拖动排序"><AdminIcon Name="grip" Size="18" /></span>
                                            <div class="rule-copy">
                                                <div class="rule-title-line"><strong>@rule.Name</strong><span class="status-pill @(rule.IsEnabled ? "status-enabled" : "status-disabled")">@(rule.IsEnabled ? "已启用" : "已停用")</span></div>
                                                <p>@RuleSummary(rule)</p>
                                            </div>
                                            <div class="actions rule-actions">
                                                <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => ToggleRuleAsync(rule)">@(rule.IsEnabled ? "停用" : "启用")</button>
                                                <button class="btn btn-outline-primary admin-btn compact-action" type="button" @onclick="() => OpenEditRule(rule)">编辑</button>
                                                <button class="btn btn-danger admin-btn compact-action" type="button" @onclick="() => DeleteRuleAsync(rule.Id)">删除</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="outbound-policy">
                                <div class="outbound-policy-intro">
                                    <div>
                                        <h3>发信身份与投递策略</h3>
                                        <p>这些设置会影响服务器对外发信时使用的 EHLO/HELO 名称、源 IP 以及同域投递方式。</p>
                                    </div>
                                </div>

                                <div class="form-grid outbound-settings-fields">
                                    <label class="form-field">
                                        <span class="config-help" data-help="外部 Relay 使用系统配置的上游 SMTP；Direct MX 由本服务器直接连接收件域 MX。">外发方式</span>
                                        <SelectDropdown TValue="OutboundMode"
                                                        @bind-Value="_outboundMode"
                                                        Options="OutboundModeOptions"
                                                        AriaLabel="外发方式" />
                                        @if (_outboundMode == OutboundMode.Relay)
                                        {
                                            <small class="muted">请确认系统设置中的 Relay 主机、端口、安全方式和凭据已经配置。</small>
                                        }
                                        else
                                        {
                                            <small class="muted">Direct MX 需要可用的公网出口、PTR、SPF 和 DKIM 配置。</small>
                                        }
                                    </label>
                                    <label class="form-field">
                                        <span class="config-help" data-help="发信时发送给对方邮件系统的 EHLO/HELO 名称。建议使用能通过反向 DNS 解释的主机名。">发件主机名</span>
                                        <input class="form-control" @bind="_smtpHostName" placeholder="@(_mailHostName)" />
                                    </label>
                                </div>
                                <div class="outbound-policy-grid">
                                    <div class="policy-card">
                                        <div class="policy-card-heading">
                                            <h3>发件 IP 配置</h3>
                                            <p>左侧为实际发信优先级，右侧为当前检测到的本机公网 IP；列表最后固定回退到系统默认出口。</p>
                                        </div>
                                        @{
                                            var selectedIps = OutboundIpItems;
                                            var availableIps = AvailableOutboundAddressOptions;
                                        }
                                        <PriorityTransferList TItem="string"
                                                              SelectedItems="selectedIps"
                                                              AvailableItems="availableIps.Select(x => x.Address).ToList()"
                                                              SelectedItemsChanged="SetOutboundIpItemsFromComponent"
                                                              KeySelector="ip => ip"
                                                              ItemLabel="ip => ip"
                                                              ItemDescription="IpOptionLabel"
                                                              SelectedTitle="发件 IP 列表"
                                                              SelectedSubtitle="可拖拽调整优先级"
                                                              AvailableTitle="所有 IP 列表"
                                                              AvailableSubtitle="拖到左侧启用"
                                                              EmptySelectedText="未指定发件 IP，直接使用系统默认出口。"
                                                              EmptyAvailableText="未检测到未使用的公网 IP。"
                                                              AllowRemoveFromSelected="true"
                                                              AvailableIcon="bi-hdd-network">
                                            <SelectedFooterTemplate>
                                                <div class="priority-row priority-fallback">
                                                    <span class="priority-index">末</span>
                                                    <div>
                                                        <strong>系统默认</strong>
                                                        <small>未命中指定地址族或绑定失败时使用系统路由</small>
                                                    </div>
                                                </div>
                                            </SelectedFooterTemplate>
                                        </PriorityTransferList>
                                    </div>

                                    <div class="policy-card">
                                        <div class="policy-card-heading">
                                            <h3>同域投递</h3>
                                            <p>同一域名内的账号互发时优先走本地邮箱投递，不绕回公网 MX。</p>
                                        </div>
                                        <SwitchField CssClass="switch-card" Label="同域邮件直接投递" Description="开启后，本地账号之间的邮件直接写入收件箱。" @bind-Value="_directDeliverSameDomain" />
                                    </div>
                                </div>
                                <div class="panel-actions">
                                    <button class="btn btn-primary admin-btn" type="button" @onclick="SaveDetailsAsync">保存发信设置</button>
                                </div>
                            </div>
                        }
                    </section>
                }
                else if (_section == "imap")
                {
                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>IMAP 默认文件夹</h2>
                                <p>这是全局设置：新账号创建时写入，已有账号下次 IMAP 登录时自动补齐。</p>
                            </div>
                        </div>
                        <label>默认文件夹，一行一个
                            <textarea class="folder-editor" @bind="_defaultFoldersText"></textarea>
                        </label>
                        <p class="muted">系统会始终保留 INBOX 并放在第一位，同时去重并拒绝空值和不安全路径。</p>
                        <div class="panel-actions">
                            <button class="btn btn-primary admin-btn" type="button" @onclick="SaveMailboxSettingsAsync">保存文件夹</button>
                        </div>
                    </section>
                }
                else if (_section == "queue")
                {
                    <DeliveryQueuePanel @ref="_queuePanel" DomainId="Id" ShowHeaderRefresh="false" />
                }
                else if (_section == "logs")
                {
                    <section class="panel">
                        <div class="panel-header">
                            <div>
                                <h2>域名日志</h2>
                                <p>显示这个域名、其账号、别名以及默认文件夹相关的最近后台操作。</p>
                            </div>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>时间</th>
                                        <th>操作者</th>
                                        <th>动作</th>
                                        <th>资源</th>
                                        <th>详情</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (_audits.Count == 0)
                                {
                                    <tr><td colspan="5" class="empty-cell">暂无域名相关操作记录。</td></tr>
                                }
                                else
                                {
                                    @foreach (var audit in _audits)
                                    {
                                        <tr>
                                            <td>@audit.CreatedAt.LocalDateTime</td>
                                            <td>@audit.Actor</td>
                                            <td><code>@audit.Action</code></td>
                                            <td>@audit.Resource</td>
                                            <td>@audit.Detail</td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </main>
        </div>
    </div>
}

@if (_accountModalOpen && _view is not null)
{
    <div class="modal-backdrop" @onclick="CloseAccountModal">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>添加账号</h2>
                    <p>只填写 @@ 前缀，后缀固定为 @_view.Domain.Name。</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CloseAccountModal">×</button>
            </div>
            <div class="form-grid">
                <label>账号前缀
                    <div class="input-suffix">
                        <input @bind="_accountLocalPart" placeholder="alice" />
                        <span>@@@_view.Domain.Name</span>
                    </div>
                </label>
                <label>初始密码
                    <input type="password" @bind="_accountPassword" placeholder="至少 12 位密码" />
                </label>
                <label>确认初始密码
                    <input type="password" @bind="_accountPasswordConfirm" placeholder="再次输入初始密码" />
                </label>
                <label>配额 MB
                    <input type="number" min="1" max="@_domainQuotaMiB" @bind="_accountQuotaMiB" />
                    <small class="field-hint">不能超过域名总配额 @_domainQuotaMiB MB。</small>
                </label>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseAccountModal">取消</button>
                <button class="btn btn-primary admin-btn" type="button" @onclick="CreateAccountAsync">创建账号</button>
            </div>
        </div>
    </div>
}

@if (_editingAccount is not null)
{
    <div class="modal-backdrop" @onclick="RequestCloseEditAccount">
        <div class="modal-panel account-editor-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>编辑账号</h2>
                    <p>@_editingAccount.Address</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="RequestCloseEditAccount">×</button>
            </div>
            <div class="account-editor-body">
                <section class="modal-fieldset">
                    <h3>账号状态</h3>
                    <SwitchField CssClass="switch-card account-status-switch"
                                 Label="启用账号"
                                 Description="关闭后该账号无法登录客户端，也不再参与收发；邮箱内容会保留。"
                                 @bind-Value="_editEnabled" />
                </section>
                <section class="modal-fieldset">
                    <h3>容量与密码</h3>
                    <div class="form-grid two-column">
                        <label>配额 MB
                            <input type="number" min="1" max="@_domainQuotaMiB" @bind="_editQuotaMiB" />
                            <small class="field-hint">不能超过域名总配额 @_domainQuotaMiB MB。</small>
                        </label>
                        <label>新密码（可选）
                            <input type="password" @bind="_editPassword" placeholder="留空则不修改密码" />
                            <small class="field-hint">填写时至少 12 位。</small>
                        </label>
                        <label>确认新密码
                            <input type="password" @bind="_editPasswordConfirm" placeholder="再次输入新密码" />
                        </label>
                    </div>
                </section>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="RequestCloseEditAccount">取消</button>
                <button class="btn btn-primary admin-btn" type="button" @onclick="SaveAccountEditAsync">保存账号</button>
            </div>
        </div>
    </div>
}

@if (_confirmDiscardAccountEdit)
{
    <div class="modal-backdrop stacked-modal-backdrop" @onclick="CancelDiscardAccountEdit">
        <div class="modal-panel confirm-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>放弃未保存修改？</h2>
                    <p>当前账号编辑内容还没有保存，关闭后这些输入会丢失。</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CancelDiscardAccountEdit">×</button>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CancelDiscardAccountEdit">继续编辑</button>
                <button class="btn btn-danger admin-btn" type="button" @onclick="DiscardAccountEdit">放弃修改</button>
            </div>
        </div>
    </div>
}

@if (_pendingDisableAccount is not null)
{
    <div class="modal-backdrop" @onclick="CloseDisableAccount">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>停用账号</h2>
                    <p>停用 <strong>@_pendingDisableAccount.Address</strong> 后，该账号无法登录客户端，也不再参与收发；邮箱内容会保留。</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CloseDisableAccount">×</button>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseDisableAccount">取消</button>
                <button class="btn btn-danger admin-btn" type="button" @onclick="DisableAccountAsync">停用账号</button>
            </div>
        </div>
    </div>
}

@if (_aliasModalOpen && _view is not null)
{
    <div class="modal-backdrop" @onclick="CloseAliasModal">
        <div class="modal-panel alias-editor-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>@(_editingAlias is null ? "添加别名" : "编辑别名")</h2>
                    <p>别名和目标账号必须属于当前域名；请使用目标账号的密码登录客户端。</p>
                </div>
                <button class="icon-button" type="button" @onclick="CloseAliasModal" aria-label="关闭"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="alias-editor-form">
                <label class="form-field alias-prefix-field">
                    <span>别名前缀</span>
                    <div class="input-group">
                        <input class="form-control" @bind="_aliasSourceLocalPart" @bind:event="oninput" placeholder="sales" />
                        <span class="input-group-text">@@@_view.Domain.Name</span>
                    </div>
                </label>
                <div>
                    <label class="form-label">别名模式</label>
                    <div class="segmented-control">
                        <button class="@AliasModeButtonClass(MailAliasMode.SendReceive)" type="button" @onclick="@(() => _aliasMode = MailAliasMode.SendReceive)">双向收发</button>
                        <button class="@AliasModeButtonClass(MailAliasMode.ReceiveOnly)" type="button" @onclick="@(() => _aliasMode = MailAliasMode.ReceiveOnly)">仅收信</button>
                        <button class="@AliasModeButtonClass(MailAliasMode.Disabled)" type="button" @onclick="@(() => _aliasMode = MailAliasMode.Disabled)">已禁用</button>
                    </div>
                </div>
                <div class="alias-account-picker">
                    <div>
                        <strong>绑定账号</strong>
                        <p class="muted">点击一行选择账号；别名前缀不能与任何真实账号相同。</p>
                    </div>
                    <ServerDataGrid TItem="AccountView" LoadData="LoadAliasAccountsAsync"
                                    SelectedItem="_selectedAliasAccount" SelectedItemChanged="AliasAccountSelected"
                                    SearchPlaceholder="搜索账号地址" EmptyText="没有可用账号" ColumnCount="4">
                        <HeaderTemplate>
                            <th>选择</th>
                            <th>账号</th>
                            <th>状态</th>
                            <th>配额</th>
                        </HeaderTemplate>
                        <RowTemplate Context="account">
                            <td><i class="bi @(account.Id == _aliasTargetAccountId ? "bi-record-circle-fill text-primary" : "bi-circle")"></i></td>
                            <td>@account.Address</td>
                            <td><span class="status-pill status-enabled">启用</span></td>
                            <td>@ToMiB(account.QuotaBytes) MB</td>
                        </RowTemplate>
                    </ServerDataGrid>
                </div>
                @if (AliasAddressConflicts)
                {
                    <div class="alert alert-danger mb-0">该前缀已被真实账号使用，不能创建同地址别名。</div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseAliasModal">取消</button>
                <button class="btn btn-primary admin-btn" type="button" @onclick="SaveAliasAsync" disabled="@AliasAddressConflicts">@(_editingAlias is null ? "添加别名" : "保存修改")</button>
            </div>
        </div>
    </div>
}

@if (_ruleModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseRuleModal">
        <div class="modal-panel rule-modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="modal-title-block">
                    <span class="modal-kicker">@(_ruleDirection == MailRuleDirection.Incoming ? "收信规则" : "发信规则")</span>
                    <h2>@(_editingRuleId is null ? "新建规则" : "修改规则")</h2>
                    <p>第一条命中规则生效，目标文件夹不存在时自动回退到 @(_ruleDirection == MailRuleDirection.Incoming ? "INBOX" : "Sent")。</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CloseRuleModal"><AdminIcon Name="x" /></button>
            </div>
            <div class="rule-editor-section rule-editor-meta rule-editor-meta-top">
                <label class="form-field rule-name-field">
                    <span>规则名称</span>
                    <input class="form-control" @bind="_ruleDraft.Name" @bind:event="oninput" placeholder="例如：账单邮件归档" />
                </label>
                <label class="switch-card">
                    <input type="checkbox" @bind="_ruleDraft.IsEnabled" />
                    <span class="switch-track"></span>
                    <span>启用规则</span>
                </label>
            </div>
            <div class="rule-editor-section">
                <div class="rule-editor-heading">
                    <strong><span class="required-mark">*</span>当邮件满足以下</strong>
                    <SelectDropdown TValue="MailRuleMatchMode" @bind-Value="_ruleDraft.MatchMode"
                                    Options="MatchModeOptions" AriaLabel="条件匹配方式" CssClass="match-mode-select" />
                </div>
                <div class="condition-stack">
                    @for (var index = 0; index < _ruleDraft.Conditions.Count; index++)
                    {
                        var condition = _ruleDraft.Conditions[index];
                        <div class="condition-row" @key="condition.Key">
                            <SelectDropdown TValue="MailRuleField" Value="condition.Field"
                                            ValueChanged="value => ChangeConditionField(condition, value)"
                                            Options="RuleFieldOptions" AriaLabel="规则字段" />
                            <SelectDropdown TValue="MailRuleOperator" @bind-Value="condition.Operator"
                                            Options="RuleOperatorOptions(condition.Field)" AriaLabel="规则运算符" />
                            @if (condition.Field == MailRuleField.MessageSize)
                            {
                                <div class="condition-size-input">
                                    <input class="form-control" type="number" min="0" step="0.1" @bind="condition.SizeValue" />
                                    <SelectDropdown TValue="string" @bind-Value="condition.SizeUnit"
                                                    Options="SizeUnitOptions" AriaLabel="大小单位" />
                                </div>
                            }
                            else if (condition.Field == MailRuleField.MessageTime)
                            {
                                <div class="condition-time-input"><input type="datetime-local" @bind="condition.FirstTime" />@if (condition.Operator == MailRuleOperator.Between) { <span>至</span><input type="datetime-local" @bind="condition.SecondTime" /> }</div>
                            }
                            else if (condition.Field == MailRuleField.HasAttachment)
                            {
                                <SelectDropdown TValue="string" @bind-Value="condition.BooleanValue"
                                                Options="AttachmentOptions" AriaLabel="附件状态" />
                            }
                            else
                            {
                                <TokenInput Values="condition.Tokens" ValuesChanged="values => condition.Tokens = values.ToList()" Placeholder="输入后按 Enter" />
                            }
                            <button class="icon-button subtle-icon" type="button" title="删除条件" disabled="@(_ruleDraft.Conditions.Count == 1)" @onclick="() => RemoveCondition(condition)"><AdminIcon Name="x" /></button>
                            <button class="icon-button subtle-icon" type="button" title="添加条件" @onclick="AddCondition"><AdminIcon Name="plus" /></button>
                        </div>
                    }
                </div>
            </div>
            <div class="rule-editor-section">
                <div class="rule-editor-heading"><strong><span class="required-mark">*</span>就执行以下动作</strong></div>
                @if (_ruleDirection == MailRuleDirection.Incoming)
                {
                    <label class="switch-row">
                        <input type="checkbox" @bind="_ruleDraft.MoveEnabled" />
                        <span class="switch-track"></span>
                        <span>保留本地副本并移动到文件夹</span>
                    </label>
                }
                @if (_ruleDirection == MailRuleDirection.Outgoing || _ruleDraft.MoveEnabled)
                {
                    <div class="rule-action-row">
                        <span>移动到</span>
                        <SelectDropdown TValue="string" @bind-Value="_ruleDraft.TargetMailboxName"
                                        Options="FolderOptions" AriaLabel="目标文件夹" />
                    </div>
                }
                @if (_ruleDirection == MailRuleDirection.Incoming)
                {
                    <div class="rule-action-row rule-forward-row"><span>转发到</span><TokenInput Values="_ruleDraft.ForwardTargets" ValuesChanged="values => _ruleDraft.ForwardTargets = values.ToList()" Placeholder="邮箱地址，输入后按 Enter" AriaLabel="转发目标邮箱" /></div>
                    <p class="form-text">本地邮件会先保存；外部目标使用 SRS 信封发件人转发，最多 20 个地址。</p>
                }
            </div>
            <div class="modal-actions"><button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseRuleModal">取消</button><button class="btn btn-primary admin-btn" type="button" @onclick="SaveRuleAsync">保存规则</button></div>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyList<AdminSelectOption<OutboundMode>> OutboundModeOptions =
    [
        new(OutboundMode.Relay, "外部 Relay"),
        new(OutboundMode.DirectMx, "Direct MX")
