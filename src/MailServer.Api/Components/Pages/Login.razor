@page "/admin/login"
@layout MailServer.Api.Components.Layout.LoginLayout
@attribute [AllowAnonymous]
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor Http

<PageTitle>管理员登录</PageTitle>

<section class="login-split">
    <div class="login-art-panel">
        <a class="login-brand" href="/admin/login" aria-label="MailServer admin">
            <span class="admin-brand-mark">M</span>
            <span>MailServer</span>
        </a>
        <img class="login-illustration" src="/login-admin-visual.png" alt="" />
        <span class="login-copyright">Copyright © 2026 MailServer</span>
    </div>

    <div class="login-form-panel">
        <div class="login-form-card">
            <h1>欢迎登录</h1>
            <p>开箱即用的一站式邮件系统解决方案</p>
            @if (Error == 1)
            {
                <div class="error login-error">用户名或密码错误。</div>
            }
            <form method="post" action="/admin/session/login" class="login-form">
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <label class="login-field">
                    <span class="field-icon">●</span>
                    <input name="userName" autocomplete="username" placeholder="用户名" required />
                </label>
                <label class="login-field">
                    <span class="field-icon">◆</span>
                    <input name="password" type="password" autocomplete="current-password" placeholder="密码" required />
                    <span class="field-action">◎</span>
                </label>
                <label class="checkbox login-remember"><input name="remember" type="checkbox" /> 保持登录</label>
                <button class="login-submit" type="submit">登录</button>
            </form>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery] public int? Error { get; set; }

    private string Token =>
        Http.HttpContext is null
            ? string.Empty
            : Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken ?? string.Empty;
}
