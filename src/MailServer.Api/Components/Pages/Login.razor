@page "/admin/login"
@attribute [AllowAnonymous]
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor Http

<PageTitle>管理员登录</PageTitle>
<div class="login-card">
    <h1>管理员登录</h1>
    @if (Error == 1)
    {
        <p class="error">用户名或密码错误。</p>
    }
    <form method="post" action="/admin/session/login">
        <input type="hidden" name="__RequestVerificationToken" value="@Token" />
        <label>用户名<input name="userName" autocomplete="username" required /></label>
        <label>密码<input name="password" type="password" autocomplete="current-password" required /></label>
        <label class="checkbox"><input name="remember" type="checkbox" /> 保持登录</label>
        <button type="submit">登录</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public int? Error { get; set; }
    private string Token =>
        Http.HttpContext is null
            ? string.Empty
            : Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken ?? string.Empty;
}
