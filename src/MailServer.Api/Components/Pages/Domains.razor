@page "/admin/domains"
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject DomainDnsService Dns
@inject AuthenticationStateProvider Authentication
@inject AdminToastService Toasts
@inject PermissionService Permissions

<PageTitle>域名管理</PageTitle>

<AdminPageHeader Title="域名管理" Description="管理邮件域名、DNS、SSL/TLS、账号与外发方式。" CssClass="domain-list-heading">
    <Actions>
        <button class="btn btn-outline-primary admin-btn" type="button" disabled="@_loading" @onclick="ReloadAsync" aria-label="刷新域名列表">
            <i class="bi bi-arrow-clockwise"></i>
            刷新
        </button>
    </Actions>
</AdminPageHeader>

@if (_accessDenied)
{
    <AccessDeniedPanel />
}

<section class="list-card domain-list-card">
    <PanelLoadingOverlay Visible="@(_loading && _domains is not null)" Text="正在刷新域名" />
    <div class="domain-filter-grid">
        <label class="form-field domain-search-field">
            <span>域名 / 主机名</span>
            <input class="form-control" @bind="_search" @onkeydown="SearchKeyDownAsync" placeholder="例如 example.com 或 mail.example.com" />
        </label>
        <label class="form-field">
            <span>状态</span>
            <SelectDropdown TValue="string" @bind-Value="_activeFilter" Options="ActiveFilterOptions" AriaLabel="状态" />
        </label>
        <label class="form-field">
            <span>SSL/TLS</span>
            <SelectDropdown TValue="string" @bind-Value="_tlsFilter" Options="TlsFilterOptions" AriaLabel="SSL/TLS" />
        </label>
        <label class="form-field">
            <span>外发方式</span>
            <SelectDropdown TValue="string" @bind-Value="_modeFilter" Options="ModeFilterOptions" AriaLabel="外发方式" />
        </label>
        <label class="form-field">
            <span>证书到期</span>
            <SelectDropdown TValue="string" @bind-Value="_expiryFilter" Options="ExpiryFilterOptions" AriaLabel="证书到期" />
        </label>
        <div class="filter-actions domain-filter-actions">
            <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="ResetAsync">清空筛选</button>
            <button class="btn btn-primary admin-btn" type="button" @onclick="SearchAsync">
                <i class="bi bi-search"></i>
                搜索
            </button>
        </div>
    </div>

    @if (_selected.Count > 0)
    {
        <div class="batch-action-bar">
            <strong>已选择 @_selected.Count 项</strong>
            @if (SelectedAllCan(PermissionCodes.DomainRead))
            {
                <button class="btn btn-outline-primary admin-btn" type="button" disabled="@_batchBusy" @onclick="CheckSelectedDnsAsync">
                    <i class="bi bi-shield-check"></i>
                    检测 DNS
                </button>
            }
            @if (SelectedAllCan(PermissionCodes.DomainManage))
            {
                <button class="btn btn-outline-primary admin-btn" type="button" disabled="@(_batchBusy || !HasSelectedActiveDomains)" @onclick="DisableSelectedDomainsAsync">
                    <i class="bi bi-pause-circle"></i>
                    停用域名
                </button>
                <button class="btn btn-danger admin-btn" type="button"
                        disabled="@(_batchBusy || HasSelectedActiveDomains)"
                        title="活动域名必须先停用"
                        @onclick="OpenBatchDelete">
                    <i class="bi bi-trash"></i>
                    删除域名
                </button>
            }
            <button class="btn btn-outline-secondary admin-btn batch-clear" type="button" @onclick="ClearSelection">取消选择</button>
        </div>
    }

    <div class="panel-header domain-table-header">
        <div>
            <h2>域名列表</h2>
            <p>查看当前域名状态、证书、DNS、账号容量和外发方式。</p>
        </div>
        @if (_permissions.HasAllDomains(PermissionCodes.DomainManage))
        {
            <button class="btn btn-primary admin-btn" type="button" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i>
                添加域名
            </button>
        }
    </div>

    <div class="table-wrap domain-table">
        <table>
            <thead>
                <tr>
                    <th class="check-col"><input type="checkbox" aria-label="选择当前页全部域名" checked="@AllPageSelected" @onchange="TogglePageSelection" /></th>
                    <th>域名</th>
                    <th>状态</th>
                    <th>DNS 状态</th>
                    <th>SSL/TLS</th>
                    <th>证书到期时间</th>
                    <th>账号</th>
                    <th>域配额</th>
                    <th>外发方式</th>
                    <th class="actions-cell">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (_domains is null)
                {
                    <tr><td colspan="10" class="empty-cell">正在加载...</td></tr>
                }
                else if (_domains.Items.Count == 0)
                {
                    <tr><td colspan="10" class="empty-cell">没有符合筛选条件的域名。</td></tr>
                }
                else
                {
                    @foreach (var domain in _domains.Items)
                    {
                        <tr class="@(_selected.Contains(domain.Id) ? "selected-row" : null)">
                            <td class="check-col"><input type="checkbox" aria-label="选择 @domain.Name" checked="@_selected.Contains(domain.Id)" @onchange="args => ToggleSelection(domain.Id, args)" /></td>
                            <td>
                                <a class="primary-link" href="/admin/domains/@domain.Id/overview">@domain.Name</a>
                                <span class="row-hint">@(domain.MailHostName ?? "尚未设置邮件主机")</span>
                            </td>
                            <td><span class="status-pill @(domain.IsActive ? "status-enabled" : "status-disabled")">@(domain.IsActive ? "活动中" : "未启用")</span></td>
                            <td><span class="status-pill @DnsStatusClass(domain.DnsStatus)" title="@DnsStatusTitle(domain)">@DnsStatusText(domain.DnsStatus)</span></td>
                            <td><span class="status-pill @CertificateStatusClass(domain)" title="@CertificateTooltip(domain)">@CertificateStatusText(domain)</span></td>
                            <td><span class="@CertificateTextClass(domain)">@CertificateText(domain)</span></td>
                            <td>@domain.AccountCount</td>
                            <td><QuotaProgress UsedBytes="domain.UsedBytes" QuotaBytes="domain.QuotaBytes" Compact="true" AriaLabel="@($"{domain.Name} 域配额使用率")" /></td>
                            <td>@FormatOutboundMode(domain.OutboundMode)</td>
                            <td class="actions domain-row-actions">
                                <a class="button-link secondary compact-action" href="/admin/domains/@domain.Id/overview">管理配置</a>
                                @if (_permissions.Has(PermissionCodes.DomainDelete, domain.Id))
                                {
                                    <button class="btn btn-danger admin-btn compact-action" type="button"
                                            disabled="@domain.IsActive"
                                            title="@(domain.IsActive ? "请先停用域名" : "删除域名")"
                                            @onclick="() => OpenDelete(domain)">
                                        删除
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_domains is not null)
    {
        <div class="pagination-row @(_domains.TotalCount <= _pageSize ? "pagination-summary-only" : null)">
            <span>共 @_domains.TotalCount 条</span>
            @if (_domains.TotalCount > _pageSize)
            {
                <button class="pager-button" type="button" title="上一页" disabled="@(_page <= 1)" @onclick="() => GoToPageAsync(_page - 1)"><i class="bi bi-chevron-left"></i></button>
                @foreach (var page in PageNumbers())
                {
                    <button class="pager-button @(page == _page ? "active" : null)" type="button" @onclick="@(() => GoToPageAsync(page))">@(page)</button>
                }
                <button class="pager-button" type="button" title="下一页" disabled="@(_page >= PageCount)" @onclick="() => GoToPageAsync(_page + 1)"><i class="bi bi-chevron-right"></i></button>
                <SelectDropdown TValue="int" @bind-Value="_pageSize" @bind-Value:after="PageSizeChangedAsync"
                                Options="PageSizeOptions" AriaLabel="每页条数" CssClass="page-size" />
                <span>前往</span>
                <input class="page-jump" type="number" min="1" max="@PageCount" @bind="_jumpPage" />
                <button class="btn btn-outline-primary admin-btn" type="button" @onclick="JumpAsync">确定</button>
            }
        </div>
    }
</section>

@if (_createOpen)
{
    <div class="modal-backdrop" @onclick="CloseCreate">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>添加域名</h2>
                    <p>创建后可继续配置证书、DNS 与邮箱账号。</p>
                </div>
                <button class="icon-button" type="button" title="关闭" @onclick="CloseCreate"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="form-grid">
                <label class="form-field">
                    <span>域名</span>
                    <input class="form-control" @bind="_createName" placeholder="example.com" />
                </label>
                <label class="form-field">
                    <span>外发方式</span>
                    <SelectDropdown TValue="OutboundMode" @bind-Value="_createMode" Options="OutboundModeOptions" AriaLabel="外发方式" />
                </label>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" @onclick="CloseCreate">取消</button>
                <button class="btn btn-primary admin-btn" type="button" @onclick="CreateAsync">创建域名</button>
            </div>
        </div>
    </div>
}

@if (_deleteOpen)
{
    <div class="modal-backdrop" @onclick="CloseDelete">
        <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="delete-domain-title" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 id="delete-domain-title">删除域名</h2>
                    <p>该操作会删除域名、账号、邮箱、相关队列和托管安全文件，无法撤销。</p>
                </div>
                <button class="icon-button" type="button" title="关闭" disabled="@_deleteBusy" @onclick="CloseDelete"><i class="bi bi-x-lg"></i></button>
            </div>
            @if (_deleteDomain is not null)
            {
                <p>请输入完整域名 <strong>@_deleteDomain.Name</strong> 进行确认。</p>
            }
            else
            {
                <p>即将删除 @_selected.Count 个已停用域名。请输入 <strong>DELETE @_selected.Count</strong> 进行确认。</p>
            }
            <label class="form-field">
                <span>确认文字</span>
                <input class="form-control" @bind="_deleteConfirmation" @bind:event="oninput" autocomplete="off" />
            </label>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary admin-btn" type="button" disabled="@_deleteBusy" @onclick="CloseDelete">取消</button>
                <button class="btn btn-danger admin-btn" type="button" disabled="@(_deleteBusy || !DeleteConfirmationMatches)" @onclick="DeleteAsync">
                    @if (_deleteBusy) { <span class="spinner-border spinner-border-sm"></span> }
                    确认删除
                </button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<DomainListItemView>? _domains;
    private readonly HashSet<Guid> _selected = [];
    private string _search = string.Empty;
    private string _activeFilter = string.Empty;
    private string _tlsFilter = string.Empty;
    private string _modeFilter = string.Empty;
    private string _expiryFilter = nameof(DomainExpiryFilter.Any);
    private int _page = 1;

    private static readonly IReadOnlyList<AdminSelectOption<string>> ActiveFilterOptions =
    [
        new(string.Empty, "全部"),
        new("active", "活动"),
        new("disabled", "停用")
    ];

    private static readonly IReadOnlyList<AdminSelectOption<string>> TlsFilterOptions =
    [
        new(string.Empty, "全部"),
        new("configured", "已配置"),
        new("missing", "未配置")
    ];

    private static readonly IReadOnlyList<AdminSelectOption<string>> ModeFilterOptions =
    [
        new(string.Empty, "全部"),
        new(nameof(OutboundMode.Relay), "外部 Relay"),
        new(nameof(OutboundMode.DirectMx), "Direct MX")
    ];

    private static readonly IReadOnlyList<AdminSelectOption<string>> ExpiryFilterOptions =
    [
        new(nameof(DomainExpiryFilter.Any), "全部"),
        new(nameof(DomainExpiryFilter.Expired), "已过期"),
        new(nameof(DomainExpiryFilter.Within7Days), "7 天内"),
        new(nameof(DomainExpiryFilter.Within30Days), "8 - 30 天"),
        new(nameof(DomainExpiryFilter.Within60Days), "31 - 60 天"),
        new(nameof(DomainExpiryFilter.Later), "60 天以上")
    ];

    private static readonly IReadOnlyList<AdminSelectOption<int>> PageSizeOptions =
    [
        new(10, "10 条/页"),
        new(20, "20 条/页"),
        new(50, "50 条/页")
    ];

    private static readonly IReadOnlyList<AdminSelectOption<OutboundMode>> OutboundModeOptions =
    [
        new(OutboundMode.Relay, "外部 Relay"),
        new(OutboundMode.DirectMx, "Direct MX")
    ];
    private int _pageSize = 20;
    private int _jumpPage = 1;
    private bool _batchBusy;
    private bool _createOpen;
    private bool _deleteOpen;
    private bool _deleteBusy;
    private DomainListItemView? _deleteDomain;
    private string _deleteConfirmation = string.Empty;
    private string _createName = string.Empty;
    private OutboundMode _createMode = OutboundMode.Relay;
    private bool _accessDenied;
    private bool _loading;
    private PermissionSnapshot _permissions = new();
    private PermittedDomainScope _domainScope = new(false, new HashSet<Guid>());

    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _permissions = await Permissions.GetSnapshotAsync(user, CancellationToken.None);
        _domainScope = await Permissions.GetPermittedDomainScopeAsync(user, PermissionCodes.DomainList, CancellationToken.None);
        if (!_domainScope.HasAny)
        {
            _accessDenied = true;
            _domains = new PagedResult<DomainListItemView>([], 1, _pageSize, 0);
            return;
        }

        await ReloadAsync();
    }
    private int PageCount => Math.Max(1, (int)Math.Ceiling((_domains?.TotalCount ?? 0) / (double)_pageSize));
    private bool AllPageSelected => _domains is { Items.Count: > 0 } && _domains.Items.All(x => _selected.Contains(x.Id));
    private bool HasSelectedActiveDomains => _domains?.Items.Any(x => _selected.Contains(x.Id) && x.IsActive) == true;

    private async Task ReloadAsync()
    {
        if (_accessDenied) return;
        if (_loading) return;
        _loading = true;
        try
        {
            var filter = new DomainSearchFilter(
                _search,
                _activeFilter switch { "active" => true, "disabled" => false, _ => null },
                _tlsFilter switch { "configured" => true, "missing" => false, _ => null },
                Enum.TryParse<OutboundMode>(_modeFilter, out var mode) ? mode : null,
                Enum.TryParse<DomainExpiryFilter>(_expiryFilter, out var expiry) ? expiry : DomainExpiryFilter.Any);
            _domains = await Administration.SearchDomainsAsync(filter, _page, _pageSize, _domainScope, CancellationToken.None);
            _page = Math.Min(_domains.Page, PageCount);
            _jumpPage = _page;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        _selected.Clear();
        await ReloadAsync();
    }

    private async Task SearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task ResetAsync()
    {
        _search = _activeFilter = _tlsFilter = _modeFilter = string.Empty;
        _expiryFilter = nameof(DomainExpiryFilter.Any);
        await SearchAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Clamp(page, 1, PageCount);
        _selected.Clear();
        await ReloadAsync();
    }

    private async Task PageSizeChangedAsync()
    {
        _page = 1;
        _selected.Clear();
        await ReloadAsync();
    }

    private async Task JumpAsync() => await GoToPageAsync(_jumpPage);

    private IEnumerable<int> PageNumbers()
    {
        var start = Math.Max(1, Math.Min(_page - 2, PageCount - 4));
        var end = Math.Min(PageCount, start + 4);
        for (var page = start; page <= end; page++)
        {
            yield return page;
        }
    }

    private void ToggleSelection(Guid id, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private void TogglePageSelection(ChangeEventArgs args)
    {
        if (_domains is null)
        {
            return;
        }

        if (args.Value is true)
        {
            foreach (var item in _domains.Items)
            {
                _selected.Add(item.Id);
            }
        }
        else
        {
            foreach (var item in _domains.Items)
            {
                _selected.Remove(item.Id);
            }
        }
    }

    private void ClearSelection() => _selected.Clear();

    private bool DeleteConfirmationMatches =>
        _deleteDomain is not null
            ? _deleteConfirmation.Equals(_deleteDomain.Name, StringComparison.OrdinalIgnoreCase)
            : _deleteConfirmation.Equals($"DELETE {_selected.Count}", StringComparison.Ordinal);

    private void OpenDelete(DomainListItemView domain)
    {
        if (domain.IsActive)
        {
            Toasts.Error("请先停用域名再删除。");
            return;
        }
        _deleteDomain = domain;
        _deleteConfirmation = string.Empty;
        _deleteOpen = true;
    }

    private void OpenBatchDelete()
    {
        if (_selected.Count == 0 || HasSelectedActiveDomains) return;
        _deleteDomain = null;
        _deleteConfirmation = string.Empty;
        _deleteOpen = true;
    }

    private void CloseDelete()
    {
        if (_deleteBusy) return;
        _deleteOpen = false;
        _deleteDomain = null;
        _deleteConfirmation = string.Empty;
    }

    private async Task DeleteAsync()
    {
        if (!DeleteConfirmationMatches || _deleteBusy) return;
        var ids = _deleteDomain is not null ? new[] { _deleteDomain.Id } : _selected.ToArray();
        if (ids.Length == 0 || ids.Any(id => !_permissions.Has(PermissionCodes.DomainDelete, id)))
        {
            Toasts.Error("当前账号没有删除所选域名的权限。");
            return;
        }
        _deleteBusy = true;
        try
        {
            await Administration.DeleteDomainsAsync(ids, await ActorAsync(), CancellationToken.None);
            _deleteOpen = false;
            _deleteDomain = null;
            _deleteConfirmation = string.Empty;
            _selected.Clear();
            Toasts.Success("域名已删除。");
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _deleteBusy = false;
        }
    }

    private async Task CheckSelectedDnsAsync() => await RunBatchAsync(async () =>
    {
        if (!RequireSelectedPermission(PermissionCodes.DomainDnsCheck)) return;
        await Dns.CheckManyAsync(_selected.ToArray(), CancellationToken.None);
        Toasts.Success("DNS 批量检测完成。");
    });

    private async Task DisableSelectedDomainsAsync() => await RunBatchAsync(async () =>
    {
        if (!RequireSelectedPermission(PermissionCodes.DomainUpdate)) return;
        foreach (var id in _selected.ToArray())
        {
            await Administration.UpdateDomainAsync(id, false, null, null, null, await ActorAsync(), CancellationToken.None);
        }

        Toasts.Success("所选域名已停用。");
    });

    private async Task RunBatchAsync(Func<Task> action)
    {
        try
        {
            _batchBusy = true;
            await action();
            _selected.Clear();
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _batchBusy = false;
        }
    }

    private void OpenCreate()
    {
        if (!_permissions.HasAllDomains(PermissionCodes.DomainManage))
        {
            Toasts.Error("当前账号没有创建域名的权限。");
            return;
        }

        _createOpen = true;
    }

    private void CloseCreate()
    {
        _createOpen = false;
    }

    private async Task CreateAsync()
    {
        try
        {
            await Administration.CreateDomainAsync(_createName, _createMode, null, null, await ActorAsync(), CancellationToken.None);
            _createName = string.Empty;
            _createMode = OutboundMode.Relay;
            _createOpen = false;
            Toasts.Success("域名已创建。");
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task<string> ActorAsync() => (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin-ui";

    private bool RequireSelectedPermission(string permissionCode)
    {
        if (_selected.Count == 0 || _selected.All(id => _permissions.Has(permissionCode, id)))
        {
            return true;
        }

        Toasts.Error("当前账号没有操作所选域名的权限。");
        return false;
    }

    private bool SelectedAllCan(string permissionCode) =>
        _selected.Count > 0 && _selected.All(id => _permissions.Has(permissionCode, id));

    private static string FormatOutboundMode(OutboundMode mode) => mode == OutboundMode.DirectMx ? "Direct MX" : "外部 Relay";
    private static string DnsStatusText(DomainDnsCheckStatus status) => status switch { DomainDnsCheckStatus.Checking => "检测中", DomainDnsCheckStatus.Healthy => "正常", DomainDnsCheckStatus.Unhealthy => "异常", _ => "待配置" };
    private static string DnsStatusClass(DomainDnsCheckStatus status) => status switch { DomainDnsCheckStatus.Checking => "status-info", DomainDnsCheckStatus.Healthy => "status-enabled", DomainDnsCheckStatus.Unhealthy => "status-error", _ => "status-warning" };
    private static string DnsStatusTitle(DomainListItemView domain) => domain.DnsCheckedAt is null ? "尚未执行 DNS 检测" : $"最近检测：{domain.DnsCheckedAt.Value.LocalDateTime:yyyy-MM-dd HH:mm}";
    private static double? CertificateDays(DomainListItemView domain) => domain.CertificateNotAfter is null ? null : (domain.CertificateNotAfter.Value - DateTimeOffset.UtcNow).TotalDays;
    private static string CertificateStatusText(DomainListItemView domain)
    {
        var days = CertificateDays(domain);
        if (!domain.HasCertificate)
        {
            return "未配置";
        }

        if (domain.CertificateNotBefore > DateTimeOffset.UtcNow || days < 0)
        {
            return "证书异常";
        }

        if (days < 7)
        {
            return "即将到期";
        }

        return "证书有效";
    }

    private static string CertificateStatusClass(DomainListItemView domain)
    {
        var days = CertificateDays(domain);
        if (!domain.HasCertificate)
        {
            return "status-disabled";
        }

        if (domain.CertificateNotBefore > DateTimeOffset.UtcNow || days < 0)
        {
            return "status-error";
        }

        return "status-enabled";
    }

    private static string CertificateTooltip(DomainListItemView domain) => !domain.HasCertificate ? "未配置 SSL/TLS 证书" : $"签发方：{domain.CertificateIssuer}\n有效期至：{domain.CertificateNotAfter:yyyy-MM-dd HH:mm}\n自动续期：未配置";
    private static string CertificateText(DomainListItemView domain)
    {
        var days = CertificateDays(domain);
        if (days is null)
        {
            return "-";
        }

        if (days < 0)
        {
            return $"已过期 {Math.Abs((int)Math.Floor(days.Value))} 天";
        }

        if (days < 1)
        {
            return "不足 1 天";
        }

        return $"{(int)Math.Ceiling(days.Value)} 天";
    }

    private static string CertificateTextClass(DomainListItemView domain)
    {
        var days = CertificateDays(domain);
        if (days is null)
        {
            return "text-muted";
        }

        if (days < 7)
        {
            return "text-danger";
        }

        if (days <= 30)
        {
            return "text-warning-strong";
        }

        if (days <= 60)
        {
            return "text-warning";
        }

        return "text-normal";
    }
}
