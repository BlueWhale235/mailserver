@page "/admin/aliases"
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject AuthenticationStateProvider Authentication

<PageTitle>别名管理</PageTitle>
<h1>别名</h1>
<div class="toolbar">
    <input @bind="_source" placeholder="sales@example.com" />
    <input @bind="_destination" placeholder="alice@example.com" />
    <button @onclick="CreateAsync">添加别名</button>
</div>
<p class="error">@_error</p>
<table>
    <thead><tr><th>来源</th><th>目标</th><th></th></tr></thead>
    <tbody>
    @foreach (var alias in _aliases)
    {
        <tr><td>@alias.Source</td><td>@alias.Destination</td><td><button class="danger" @onclick="() => DeleteAsync(alias.Id)">删除</button></td></tr>
    }
    </tbody>
</table>

@code {
    private IReadOnlyList<AliasView> _aliases = [];
    private string _source = string.Empty;
    private string _destination = string.Empty;
    private string? _error;
    protected override Task OnInitializedAsync() => ReloadAsync();
    private async Task ReloadAsync() => _aliases = await Administration.GetAliasesAsync(CancellationToken.None);
    private async Task<string> ActorAsync() => (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin-ui";
    private async Task CreateAsync()
    {
        try
        {
            await Administration.CreateAliasAsync(_source, _destination, await ActorAsync(), CancellationToken.None);
            _source = _destination = string.Empty; _error = null; await ReloadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
    }
    private async Task DeleteAsync(Guid id)
    {
        await Administration.DeleteAliasAsync(id, await ActorAsync(), CancellationToken.None);
        await ReloadAsync();
    }
}
