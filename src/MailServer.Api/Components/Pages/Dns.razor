@page "/admin/dns"
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject AuthenticationStateProvider Authentication
@inject AdminToastService Toasts
@inject PermissionService Permissions

<PageTitle>DNS 诊断</PageTitle>

<AdminPageHeader Title="DNS 诊断" Description="检查域名的 MX、SPF、DMARC、DKIM 和 MX 连通性。" />

@if (!_loaded)
{
    <div class="loading-row"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> 正在加载</div>
}
else if (!CanDiagnose)
{
    <AccessDeniedPanel />
}
else
{
<section class="panel">
    <div class="panel-header">
        <div>
            <h2>查询目标</h2>
            <p>DKIM selector 可留空，只检查公开基础记录。</p>
        </div>
    </div>
    <div class="toolbar">
        <input class="form-control" @bind="_domain" placeholder="example.com" />
        <input class="form-control" @bind="_selector" placeholder="DKIM selector" />
        <button class="btn btn-primary admin-btn" type="button" @onclick="InspectAsync">检查</button>
    </div>
</section>

@if (_result is not null)
{
    <section class="panel">
        <div class="panel-header">
            <div>
                <h2>@_result.Domain</h2>
                <p>DNS 查询结果和服务器连通性摘要。</p>
            </div>
        </div>

        <div class="definition-grid">
            <strong>MX</strong><span>@JoinValues(_result.Mx)</span>
            <strong>SPF</strong><span>@JoinValues(_result.Spf)</span>
            <strong>DMARC</strong><span>@JoinValues(_result.Dmarc)</span>
            <strong>DKIM</strong><span>@JoinValues(_result.Dkim)</span>
        </div>

        @if (_result.MxConnectivity.Count > 0)
        {
            <h3>MX 连通性</h3>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>状态</th>
                            <th>主机</th>
                            <th>地址族</th>
                            <th>地址</th>
                            <th>端口</th>
                            <th>错误</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in _result.MxConnectivity)
                    {
                        <tr>
                            <td>
                                <span class="status-pill @(item.Success ? "status-active" : "status-warning")">
                                    @(item.Success ? "OK" : "FAIL")
                                </span>
                            </td>
                            <td>@item.Host</td>
                            <td>@item.AddressFamily</td>
                            <td>@item.Address</td>
                            <td>@item.Port</td>
                            <td class="muted">@item.Error</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @foreach (var warning in _result.Warnings)
        {
            <p class="warning">@warning</p>
        }
    </section>
}
}

@code {
    private string _domain = string.Empty;
    private string _selector = string.Empty;
    private DnsDiagnosticResult? _result;
    private bool _loaded;
    private bool CanDiagnose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        CanDiagnose = await Permissions.HasPermissionAsync(user, PermissionCodes.DnsDiagnose, null, CancellationToken.None);
        _loaded = true;
    }

    private async Task InspectAsync()
    {
        if (!CanDiagnose)
        {
            Toasts.Error("当前账号没有 DNS 诊断权限。");
            return;
        }

        try
        {
            _result = await Administration.DiagnoseDnsAsync(_domain, _selector, CancellationToken.None);
            Toasts.Success("DNS 诊断完成。");
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private static string JoinValues(IReadOnlyCollection<string> values) =>
        values.Count == 0 ? "未查询到记录" : string.Join(", ", values);
}
