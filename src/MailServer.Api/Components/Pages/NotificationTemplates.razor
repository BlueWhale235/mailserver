@page "/admin/notification-templates"
@attribute [Authorize]
@inject AdminApplicationService Administration
@inject AuthenticationStateProvider Authentication
@inject AdminToastService Toasts
@inject PermissionService Permissions

<PageTitle>通知模板</PageTitle>

<AdminPageHeader Title="通知模板" Description="配置最终投递失败时发送给原发件人的退信与错误通知。">
    <Actions>
        @if (Can(PermissionCodes.SettingsRead))
        {
            <button class="btn btn-outline-primary admin-btn" type="button" disabled="@_busy" @onclick="ReloadFromButtonAsync">
                <i class="bi bi-arrow-clockwise"></i>
                刷新
            </button>
        }
    </Actions>
</AdminPageHeader>

@if (!_loaded)
{
    <div class="loading-row"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> 正在加载</div>
}
else if (!Can(PermissionCodes.SettingsRead))
{
    <AccessDeniedPanel />
}
else
{
    <section class="panel notification-template-panel">
        <PanelLoadingOverlay Visible="@_busy" Text="正在处理模板" />
        <div class="panel-header">
            <div>
                <h2>退信与错误通知模板</h2>
                <p>编辑 HTML 源码并在右侧实时预览通知效果。</p>
            </div>
        </div>
        <div class="form-grid template-top-grid">
            <label class="form-field">
                <span>发件人显示名称</span>
                <input class="form-control" @bind="_templateSenderName" maxlength="120" />
            </label>
        </div>
        <div class="tab-strip template-tabs">
            <button type="button" class="@TemplateTabClass(TemplateBounceTab)" @onclick="ShowBounceTemplate">退信模板</button>
            <button type="button" class="@TemplateTabClass(TemplateErrorTab)" @onclick="ShowErrorTemplate">错误模板</button>
        </div>
        <div class="template-editor-grid">
            <div class="template-editor-fields">
                <label class="form-field">
                    <span>@CurrentTemplateTitle 主题</span>
                    <input class="form-control" @bind="CurrentTemplateSubject" maxlength="200" />
                </label>
                <label class="form-field">
                    <span>HTML 源码</span>
                    <textarea class="form-control template-html-editor" rows="16" maxlength="8000" @bind="CurrentTemplateBody"></textarea>
                </label>
            </div>
            <div class="template-preview-panel">
                <div class="template-preview-header">
                    <strong>预览</strong>
                    <span>@CurrentTemplateSubject</span>
                </div>
                <div class="template-preview-body">
                    <iframe class="template-preview-frame" title="通知模板预览" sandbox srcdoc="@TemplatePreviewHtml"></iframe>
                </div>
            </div>
        </div>
        <p class="template-variables">可用变量：<code>{recipient}</code>、<code>{reason}</code>、<code>{queueId}</code>、<code>{attempts}</code></p>
        @if (Can(PermissionCodes.SettingsManage))
        {
            <div class="panel-actions">
                <button class="btn btn-outline-primary admin-btn" type="button" @onclick="RestoreDefaultTemplates">恢复默认</button>
                <button class="btn btn-primary admin-btn" type="button" disabled="@_busy" @onclick="SaveMessageTemplatesAsync">保存模板</button>
            </div>
        }
    </section>
}

@code {
    private const string TemplateBounceTab = "bounce";
    private const string TemplateErrorTab = "error";

    private bool _loaded;
    private PermissionSnapshot _permissions = new();
    private bool _busy;
    private string _templateSenderName = string.Empty;
    private string _templatePermanentFailureSubject = string.Empty;
    private string _templatePermanentFailureBody = string.Empty;
    private string _templateRetryExhaustedSubject = string.Empty;
    private string _templateRetryExhaustedBody = string.Empty;
    private string _templateTab = TemplateBounceTab;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _permissions = await Permissions.GetSnapshotAsync(user, CancellationToken.None);
        if (Can(PermissionCodes.SettingsRead)) await ReloadAsync();
        _loaded = true;
    }

    private async Task ReloadAsync() =>
        ApplyMessageTemplates(await Administration.GetMessageTemplateSettingsAsync(CancellationToken.None));

    private async Task ReloadFromButtonAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await ReloadAsync();
            Toasts.Success("通知模板已刷新。");
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveMessageTemplatesAsync()
    {
        if (!Can(PermissionCodes.SettingsManage))
        {
            Toasts.Error("当前账号没有编辑系统设置的权限。");
            return;
        }

        if (_busy) return;
        _busy = true;
        try
        {
            var saved = await Administration.UpdateMessageTemplateSettingsAsync(
                new MessageTemplateSettingsView(
                    _templateSenderName,
                    _templatePermanentFailureSubject,
                    _templatePermanentFailureBody,
                    _templateRetryExhaustedSubject,
                    _templateRetryExhaustedBody),
                await ActorAsync(),
                CancellationToken.None);
            ApplyMessageTemplates(saved);
            Toasts.Success("退信与错误通知模板已保存。");
        }
        catch (Exception exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void RestoreDefaultTemplates()
    {
        if (!Can(PermissionCodes.SettingsManage))
        {
            Toasts.Error("当前账号没有编辑系统设置的权限。");
            return;
        }

        ApplyMessageTemplates(MessageTemplateDefaults.Create());
        Toasts.Info("已恢复默认模板，保存后生效。");
    }

    private void ApplyMessageTemplates(MessageTemplateSettingsView settings)
    {
        _templateSenderName = settings.SenderDisplayName;
        _templatePermanentFailureSubject = settings.PermanentFailureSubject;
        _templatePermanentFailureBody = settings.PermanentFailureBody;
        _templateRetryExhaustedSubject = settings.RetryExhaustedSubject;
        _templateRetryExhaustedBody = settings.RetryExhaustedBody;
    }

    private async Task<string> ActorAsync() =>
        (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin-ui";

    private bool Can(string code) => _permissions.Has(code);
    private string CurrentTemplateTitle => _templateTab == TemplateErrorTab ? "错误模板" : "退信模板";

    private string CurrentTemplateSubject
    {
        get => _templateTab == TemplateErrorTab ? _templateRetryExhaustedSubject : _templatePermanentFailureSubject;
        set
        {
            if (_templateTab == TemplateErrorTab) _templateRetryExhaustedSubject = value;
            else _templatePermanentFailureSubject = value;
        }
    }

    private string CurrentTemplateBody
    {
        get => _templateTab == TemplateErrorTab ? _templateRetryExhaustedBody : _templatePermanentFailureBody;
        set
        {
            if (_templateTab == TemplateErrorTab) _templateRetryExhaustedBody = value;
            else _templatePermanentFailureBody = value;
        }
    }

    private string TemplatePreviewHtml => SystemSettingsService.RenderHtmlTemplate(
        CurrentTemplateBody,
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["recipient"] = "user@example.com",
            ["reason"] = "550 5.1.1 User unknown",
            ["queueId"] = "0123456789abcdef",
            ["attempts"] = "6"
        });

    private void ShowBounceTemplate() => _templateTab = TemplateBounceTab;
    private void ShowErrorTemplate() => _templateTab = TemplateErrorTab;
    private string TemplateTabClass(string tab) => _templateTab == tab ? "tab-button active" : "tab-button";
}
