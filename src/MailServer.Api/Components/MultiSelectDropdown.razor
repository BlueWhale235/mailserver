@typeparam TItem
@typeparam TValue where TValue : notnull
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="admin-multiselect @CssClass @(_open ? "open" : null)" @ref="_root">
    <button class="admin-select-trigger" type="button" disabled="@Disabled"
            aria-label="@AriaLabel" aria-haspopup="listbox" aria-expanded="@_open"
            @onclick="ToggleOpen">
        <span>@TriggerText</span>
        <i class="bi bi-chevron-down" aria-hidden="true"></i>
    </button>
    @if (_open)
    {
        <div class="admin-multiselect-menu" role="listbox" aria-label="@AriaLabel" aria-multiselectable="true" @onclick:stopPropagation>
            @if (Searchable)
            {
                <div class="input-icon admin-multiselect-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input class="form-control" value="@_search" @oninput="SearchChanged" placeholder="@SearchPlaceholder" />
                </div>
            }
            <div class="admin-multiselect-actions">
                <label class="admin-multiselect-select-all">
                    <input type="checkbox" checked="@AllFilteredSelected" @onchange="ToggleAllFilteredAsync" />
                    <span>全选当前结果</span>
                </label>
                @if (SelectedValues.Count > 0)
                {
                    <button class="admin-multiselect-clear" type="button" @onclick="ClearAsync">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        取消选择
                    </button>
                }
            </div>
            <div class="admin-multiselect-options">
                @foreach (var item in FilteredItems)
                {
                    var value = ValueSelector(item);
                    var selected = SelectedValues.Contains(value);
                    <label class="admin-multiselect-option @(selected ? "selected" : null)">
                        <input type="checkbox" checked="@selected" @onchange="args => ToggleItemAsync(value, args)" />
                        <span class="admin-multiselect-label">@TextSelector(item)</span>
                        @if (DescriptionSelector is not null)
                        {
                            <small>@DescriptionSelector(item)</small>
                        }
                    </label>
                }
                @if (FilteredItems.Count == 0)
                {
                    <div class="empty-cell">没有匹配的结果</div>
                }
            </div>
            <div class="admin-multiselect-footer">
                <span>共 @Items.Count 项</span>
                <span>已选择 <strong>@SelectedValues.Count</strong> 项</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, TValue> ValueSelector { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TItem, string> TextSelector { get; set; } = null!;
    [Parameter] public Func<TItem, string>? DescriptionSelector { get; set; }
    [Parameter] public IReadOnlySet<TValue> SelectedValues { get; set; } = new HashSet<TValue>();
    [Parameter] public EventCallback<IReadOnlySet<TValue>> SelectedValuesChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "请选择";
    [Parameter] public string SelectedUnit { get; set; } = "项";
    [Parameter] public string SearchPlaceholder { get; set; } = "搜索";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Searchable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    private bool _open;
    private string _search = string.Empty;
    private ElementReference _root;
    private DotNetObjectReference<MultiSelectDropdown<TItem, TValue>>? _dotNetReference;
    private string? _dropdownId;

    private string TriggerText => SelectedValues.Count == 0
        ? Placeholder
        : $"已选择 {SelectedValues.Count} {SelectedUnit}";

    private IReadOnlyList<TItem> FilteredItems
    {
        get
        {
            var items = string.IsNullOrWhiteSpace(_search)
                ? Items
                : Items.Where(item => TextSelector(item).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
            return items.OrderBy(TextSelector, StringComparer.OrdinalIgnoreCase).ToArray();
        }
    }

    private bool AllFilteredSelected => FilteredItems.Count > 0
                                        && FilteredItems.All(item => SelectedValues.Contains(ValueSelector(item)));

    private async Task ToggleOpen()
    {
        if (Disabled)
        {
            return;
        }

        if (_open)
        {
            await CloseAsync();
            return;
        }

        _open = true;
        await RegisterAsync();
    }

    private async Task CloseAsync()
    {
        _open = false;
        await UnregisterAsync();
    }

    [JSInvokable]
    public async Task CloseFromOutsideAsync()
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        await UnregisterAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SearchChanged(ChangeEventArgs args) => _search = args.Value?.ToString() ?? string.Empty;

    private async Task ToggleItemAsync(TValue value, ChangeEventArgs args)
    {
        var selected = SelectedValues.ToHashSet();
        if (args.Value is true)
        {
            selected.Add(value);
        }
        else
        {
            selected.Remove(value);
        }

        await SelectedValuesChanged.InvokeAsync(selected);
    }

    private async Task ToggleAllFilteredAsync(ChangeEventArgs args)
    {
        var selected = SelectedValues.ToHashSet();
        foreach (var item in FilteredItems)
        {
            var value = ValueSelector(item);
            if (args.Value is true)
            {
                selected.Add(value);
            }
            else
            {
                selected.Remove(value);
            }
        }

        await SelectedValuesChanged.InvokeAsync(selected);
    }

    private Task ClearAsync() => SelectedValuesChanged.InvokeAsync(new HashSet<TValue>());

    private async Task RegisterAsync()
    {
        _dotNetReference ??= DotNetObjectReference.Create(this);
        _dropdownId = await JS.InvokeAsync<string>("mailserverDropdowns.register", _root, _dotNetReference);
    }

    private async Task UnregisterAsync()
    {
        if (string.IsNullOrWhiteSpace(_dropdownId))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("mailserverDropdowns.unregister", _dropdownId);
        }
        catch (JSDisconnectedException)
        {
        }

        _dropdownId = null;
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterAsync();
        _dotNetReference?.Dispose();
    }
}
