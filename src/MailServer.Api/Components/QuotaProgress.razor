<div class="quota-progress @LevelClass @(Compact ? "quota-progress-compact" : null) @CssClass"
     title="@($"{FormatBytes(UsedBytes)} / {FormatBytes(QuotaBytes)}")">
    <div class="quota-progress-copy">
        <span>@FormatBytes(UsedBytes) / @FormatBytes(QuotaBytes)</span>
        <small>@RoundedPercentage%</small>
    </div>
    <div class="quota-progress-track"
         role="progressbar"
         aria-label="@AriaLabel"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@RoundedPercentage">
        <span class="quota-progress-value" style="width: @PercentageStyle"></span>
    </div>
</div>

@code {
    [Parameter] public long UsedBytes { get; set; }
    [Parameter] public long QuotaBytes { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "配额使用率";
    [Parameter] public string? CssClass { get; set; }

    private double Percentage => QuotaBytes <= 0 ? 100 : Math.Clamp(UsedBytes * 100d / QuotaBytes, 0, 100);
    private int RoundedPercentage => (int)Math.Round(Percentage);
    private string PercentageStyle => $"{Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
    private string LevelClass => Percentage >= 90 ? "quota-danger" : Percentage >= 75 ? "quota-warning" : "quota-normal";

    private static string FormatBytes(long value) => value switch
    {
        >= 1_073_741_824 => $"{value / 1_073_741_824d:0.##} GB",
        >= 1_048_576 => $"{value / 1_048_576d:0.##} MB",
        >= 1024 => $"{value / 1024d:0.##} KB",
        _ => $"{value} B"
    };
}
