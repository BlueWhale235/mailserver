{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "TransportSecurity": {
    "TrustedDnssecResolvers": "",
    "PolicyFetchTimeoutSeconds": 60,
    "PolicyRefreshHours": 24,
    "ReportOrganizationName": "MailServer",
    "ReportContactInfo": "postmaster@localhost"
  },
  "Storage": {
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "Maintenance": {
    "SoftDeleteRetentionDays": 30,
    "PollIntervalSeconds": 30,
    "TemporaryFileRetentionHours": 24,
    "OrphanFileRetentionDays": 7
  },
  "Cluster": {
    "Enabled": false,
    "RecoveryRequired": false,
    "Role": "Primary",
    "Endpoint": "",
    "PrimaryEndpoint": "",
    "WitnessEndpoint": "",
    "ReplicationPollSeconds": 2,
    "LeaseSeconds": 15,
    "AcknowledgementTimeoutSeconds": 10,
    "AllowDegradedWrites": false
  },
  "ClusterTransport": {
    "Enabled": false,
    "ListenAddress": "0.0.0.0",
    "Port": 2526,
    "AdvertiseEndpoint": "",
    "CertificatePath": "security-assets/cluster/node.crt",
    "PrivateKeyPath": "security-assets/cluster/node.key",
    "TrustedCaPath": "security-assets/cluster/ca.crt",
    "ConnectTimeoutSeconds": 15,
    "ContentChunkBytes": 65536
  },
  "ClusterSyncThrottle": {
    "Enabled": true,
    "SampleIntervalSeconds": 10,
    "BusyHoldSeconds": 60,
    "RecoverySamples": 3,
    "NormalBatchSize": 200,
    "BusyMetadataBatchSize": 20,
    "CpuBusyPercent": 85
  },
  "TrustedProxies": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "SecurityAssets": {
    "RootPath": "security-assets"
  },
  "MailboxDefaults": {
    "Folders": [ "INBOX", "Sent", "Drafts", "Trash", "Junk", "Archives" ]
  },
  "MailRules": {
    "SentCopyGraceSeconds": 60,
    "SentCopyDeduplicationMinutes": 15
  },
  "Forwarding": {
    "SrsSecret": "",
    "MaxHops": 5,
    "MaxAgeDays": 21,
    "MaxTargetsPerRule": 20
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Certificates": {
    "DefaultMailHostName": "mail.localhost",
    "AllowSingleCertificateFallback": true,
    "Admin": {
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "PrivateKeyPassword": ""
    }
  },
  "AdminServer": {
    "BindAddress": "127.0.0.1",
    "Http": {
      "Enabled": true,
      "Port": 8080
    },
    "Https": {
      "Enabled": false,
      "Port": 8443,
      "RedirectHttp": true
    }
  },
  "Jwt": {
    "Issuer": "mailserver",
    "Audience": "mailserver-admin",
    "SigningKey": "",
    "Minutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "MailServerLogging": {
    "Console": { "Enabled": true, "Color": true },
    "File": { "Enabled": true, "Directory": "logs" },
    "TimestampFormat": "yyyy/MM/dd HH:mm:ss"
  },
  "AllowedHosts": "*"
}
