{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "Storage": {
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Certificates": {
    "Admin": {
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "PrivateKeyPassword": ""
    }
  },
  "AdminServer": {
    "BindAddress": "127.0.0.1",
    "Http": {
      "Enabled": true,
      "Port": 8080
    },
    "Https": {
      "Enabled": false,
      "Port": 8443,
      "RedirectHttp": true
    }
  },
  "Jwt": {
    "Issuer": "mailserver",
    "Audience": "mailserver-admin",
    "SigningKey": "",
    "Minutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
