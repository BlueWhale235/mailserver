<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MailServer.Domain/MailServer.Domain.csproj" />
    <ProjectReference Include="../MailServer.Imap/MailServer.Imap.csproj" />
    <ProjectReference Include="../MailServer.Infrastructure/MailServer.Infrastructure.csproj" />
    <ProjectReference Include="../MailServer.Migrations.MySql/MailServer.Migrations.MySql.csproj" />
    <ProjectReference Include="../MailServer.Migrations.PostgreSql/MailServer.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="../MailServer.Migrations.Sqlite/MailServer.Migrations.Sqlite.csproj" />
    <ProjectReference Include="../MailServer.Smtp/MailServer.Smtp.csproj" />
    <ProjectReference Include="../MailServer.Worker/MailServer.Worker.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" Exclude="wwwroot\lib\**\*;wwwroot\login-admin-visual.png">
      <LogicalName>MailServer.Api.StaticWebAssets/wwwroot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MailServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="BuildAdminSpa" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipAdminBuild)' != 'true'">
    <Exec WorkingDirectory="../MailServer.Admin" Command="npm ci" Condition="!Exists('../MailServer.Admin/node_modules') and Exists('../MailServer.Admin/package-lock.json')" />
    <Exec WorkingDirectory="../MailServer.Admin" Command="npm install" Condition="!Exists('../MailServer.Admin/node_modules') and !Exists('../MailServer.Admin/package-lock.json')" />
    <Exec WorkingDirectory="../MailServer.Admin" Command="npm run build" />
    <ItemGroup>
      <AdminSpaResource Include="..\MailServer.Admin\dist\**\*" />
      <EmbeddedResource Include="@(AdminSpaResource)">
        <LogicalName>MailServer.Api.StaticWebAssets/wwwroot/admin/%(AdminSpaResource.RecursiveDir)%(AdminSpaResource.Filename)%(AdminSpaResource.Extension)</LogicalName>
        <ManifestResourceName>MailServer.Api.StaticWebAssets/wwwroot/admin/%(AdminSpaResource.RecursiveDir)%(AdminSpaResource.Filename)%(AdminSpaResource.Extension)</ManifestResourceName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
