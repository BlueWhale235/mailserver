<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mailserver</AssemblyName>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MailServer.Api/MailServer.Api.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="../MailServer.Imap/MailServer.Imap.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="../MailServer.Infrastructure/MailServer.Infrastructure.csproj" />
    <ProjectReference Include="../MailServer.Migrations.MySql/MailServer.Migrations.MySql.csproj" />
    <ProjectReference Include="../MailServer.Migrations.PostgreSql/MailServer.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="../MailServer.Migrations.Sqlite/MailServer.Migrations.Sqlite.csproj" />
    <ProjectReference Include="../MailServer.Smtp/MailServer.Smtp.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="../MailServer.Worker/MailServer.Worker.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="AddMailServerDeploymentAssets" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\.env.example">
        <RelativePath>.env.example</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\.env.example">
        <RelativePath>.env</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\mailserver.example.json">
        <RelativePath>mailserver.example.json</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\mailserver.example.json">
        <RelativePath>mailserver.json</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\README.md">
        <RelativePath>README.md</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\certificates\README.md">
        <RelativePath>certificates\README.md</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\plugins\.gitkeep">
        <RelativePath>plugins\.gitkeep</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\..\security-assets\README.md">
        <RelativePath>security-assets\README.md</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_MailServerDeploymentWebAsset Include="$(MSBuildProjectDirectory)\..\MailServer.Api\wwwroot\**\*" />
      <ResolvedFileToPublish Include="@(_MailServerDeploymentWebAsset)">
        <RelativePath Condition="'%(_MailServerDeploymentWebAsset.LinkBase)' == ''">wwwroot\%(_MailServerDeploymentWebAsset.RecursiveDir)%(_MailServerDeploymentWebAsset.Filename)%(_MailServerDeploymentWebAsset.Extension)</RelativePath>
        <RelativePath Condition="'%(_MailServerDeploymentWebAsset.LinkBase)' != ''">wwwroot\%(_MailServerDeploymentWebAsset.LinkBase)\%(_MailServerDeploymentWebAsset.RecursiveDir)%(_MailServerDeploymentWebAsset.Filename)%(_MailServerDeploymentWebAsset.Extension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="RemoveReferencedHostPublishFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Api.exe'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Api.deps.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Api.runtimeconfig.json'
                               Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('MailServer.Api.staticwebassets.'))
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Smtp.exe'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Smtp.deps.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Smtp.runtimeconfig.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Imap.exe'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Imap.deps.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Imap.runtimeconfig.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Worker.exe'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Worker.deps.json'
                               Or '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Worker.runtimeconfig.json'
                               Or ('$(PublishSingleFile)' == 'true' And '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Api.dll')
                               Or ('$(PublishSingleFile)' == 'true' And '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Smtp.dll')
                               Or ('$(PublishSingleFile)' == 'true' And '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Imap.dll')
                               Or ('$(PublishSingleFile)' == 'true' And '%(ResolvedFileToPublish.RelativePath)' == 'MailServer.Worker.dll')" />
    </ItemGroup>
  </Target>

  <Target Name="CleanReferencedHostPublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <_ReferencedHostPublishFile Include="$(PublishDir)MailServer.Api.exe;$(PublishDir)MailServer.Api.deps.json;$(PublishDir)MailServer.Api.runtimeconfig.json;$(PublishDir)MailServer.Api.pdb" />
      <_ReferencedHostPublishFile Include="$(PublishDir)MailServer.Api.staticwebassets.*.json" />
      <_ReferencedHostPublishFile Include="$(PublishDir)MailServer.Smtp.exe;$(PublishDir)MailServer.Smtp.deps.json;$(PublishDir)MailServer.Smtp.runtimeconfig.json;$(PublishDir)MailServer.Smtp.pdb" />
      <_ReferencedHostPublishFile Include="$(PublishDir)MailServer.Imap.exe;$(PublishDir)MailServer.Imap.deps.json;$(PublishDir)MailServer.Imap.runtimeconfig.json;$(PublishDir)MailServer.Imap.pdb" />
      <_ReferencedHostPublishFile Include="$(PublishDir)MailServer.Worker.exe;$(PublishDir)MailServer.Worker.deps.json;$(PublishDir)MailServer.Worker.runtimeconfig.json;$(PublishDir)MailServer.Worker.pdb" />
      <_ReferencedHostPublishFile Include="$(PublishDir)MailServer.Api.dll;$(PublishDir)MailServer.Smtp.dll;$(PublishDir)MailServer.Imap.dll;$(PublishDir)MailServer.Worker.dll" Condition="'$(PublishSingleFile)' == 'true'" />
      <_ReferencedHostPublishFile Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_ReferencedHostPublishFile)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="CreateMailServerDeploymentDirectories" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)\logs" Condition="'$(PublishDir)' != ''" />
  </Target>

  <Target Name="CleanObsoleteAntDesignAssets" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)\wwwroot\_content\AntDesign" Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)\wwwroot\_content\AntDesign')" />
  </Target>
</Project>
