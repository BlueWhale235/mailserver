<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio folder publish profile for a Linux x64 single-file deployment. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\builds\publish\MailServer.Cli\release\linux-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- MailServer.Cli intentionally references executable host projects for in-process hosting. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <_DeploymentRootFile Include="$(MSBuildProjectDirectory)\..\..\docker-compose.yml" />
    <_DeploymentRootFile Include="$(MSBuildProjectDirectory)\..\..\Dockerfile" />
    <_DeploymentRootFile Include="$(MSBuildProjectDirectory)\..\..\.env.example" />
    <_DeploymentRootFile Include="$(MSBuildProjectDirectory)\..\..\mailserver.example.json" />
    <_DeploymentRootFile Include="$(MSBuildProjectDirectory)\..\..\README.md" />
    <_DeploymentScript Include="$(MSBuildProjectDirectory)\..\..\scripts\**\*" />
  </ItemGroup>
  <!--
	  Visual Studio can evaluate external Content items before the final PublishDir is
	  established. Copy deployment assets explicitly after Publish so VS and dotnet
	  publish produce the same folder contents.
	-->
  <Target Name="CopyDeploymentAssets" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir);$(PublishDir)scripts;$(PublishDir)certificates;$(PublishDir)plugins" />
    <Copy SourceFiles="@(_DeploymentRootFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeploymentScript)" DestinationFiles="@(_DeploymentScript->'$(PublishDir)scripts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\.env.example"
          DestinationFiles="$(PublishDir).env"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\mailserver.example.json"
          DestinationFiles="$(PublishDir)mailserver.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\certificates\README.md" DestinationFiles="$(PublishDir)certificates\README.md" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\.gitkeep" DestinationFiles="$(PublishDir)plugins\.gitkeep" SkipUnchangedFiles="true" />
  </Target>
</Project>
