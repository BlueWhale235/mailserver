{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "MailDatabase": "Data Source=data/mailserver.db"
  },
  "Storage": {
    "RootPath": "data/messages",
    "MaximumMessageBytes": 52428800
  },
  "Plugins": {
    "Path": "plugins"
  },
  "Relay": {
    "Host": "localhost",
    "Port": 25,
    "UseStartTls": true,
    "UserName": "",
    "Password": ""
  },
  "Delivery": {
    "BatchSize": 20,
    "LeaseSeconds": 120,
    "MaximumAttempts": 12,
    "PollIntervalSeconds": 5
  },
  "Worker": {
    "HostName": "mail.localhost"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
